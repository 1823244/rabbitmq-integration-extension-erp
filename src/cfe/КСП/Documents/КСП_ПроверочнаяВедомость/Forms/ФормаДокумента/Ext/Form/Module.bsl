&НаСервере
Функция ПечатьСписанияНаСервере() 
	МассивОбъектов = Новый Массив;
    МассивОбъектов.Добавить(Объект.Ссылка); 
	Возврат Документы.КСП_ПроверочнаяВедомость.ПечатьНакладнаяНаФурнитуру(МассивОбъектов, Новый СписокЗначений);
КонецФункции

&НаКлиенте
Процедура ПечатьСписания(Команда)
	Если ЗначениеЗаполнено(Объект.ДокументСписания) Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка); 
		ТабДок = ПечатьСписанияНаСервере();; 	
		// 2. Открытие сформированной печатной формы
		КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("НАКЛАДНАЯНАФУРНИТУРУ");
		КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДок; 
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,, ЭтотОбъект);
	Иначе
		Сообщить("Документ списания ещё не сделан");
	КонецЕсли;
КонецПроцедуры

