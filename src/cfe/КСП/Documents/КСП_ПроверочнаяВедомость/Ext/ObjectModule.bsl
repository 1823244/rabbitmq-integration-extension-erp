	    НайденныеСерии = Серии.НайтиСтроки(ОтборПоСериям);
		Если НайденныеСерии.Количество() = 0 Тогда
			ДвижениеПоКачеству=Движения.КСП_ПаспортКачества.Добавить();
			ДвижениеПоКачеству.Период=Дата;
			ДвижениеПоКачеству.Регистратор=Ссылка;
			ЗаполнитьЗначенияСвойств(ДвижениеПоКачеству,тов); 
		Иначе
			Для каждого стр из НайденныеСерии Цикл 
				ДвижениеПоКачеству=Движения.КСП_ПаспортКачества.Добавить();
				ДвижениеПоКачеству.Период=Дата;
				ДвижениеПоКачеству.Регистратор=Ссылка;
				ЗаполнитьЗначенияСвойств(ДвижениеПоКачеству,тов);
				ДвижениеПоКачеству.Серия=стр.Серия;				
			КонецЦикла; 
		КонецЕсли;
	КонецЦикла;    
	Движения.КСП_ПаспортКачества.Записать();
КонецПроцедуры
Процедура ДвижениеПоРегистрамПретензии()
	
	Если Не Завершена Тогда
		возврат;
	КонецЕсли;
	//Бурлаков М.Б. - начало
	//Заявка 5305
	Если (Не СпецТипНакладной=Перечисления.КСП_СпецТипНакладной.ПряжаЛот) и (СпецТипНакладной <> Перечисления.КСП_СпецТипНакладной.Фурнитура) тогда
		возврат;
	КонецЕсли;
	//Бурлаков М.Б. - конец
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад=ДокументОснование.Склад;
		//Если НовыйМеханизмПрихода тогда
		//	СкладСырья=ДокументОснование.СкладСырья;
		//КонецЕсли;
	КонецЕсли; 
	//Если Не СкладСырья=Справочники.Склады.УчастокПодготовкиИСкладированияТкани тогда
	//	//Бурлаков М.Б. - начало
	//	//Заявка 5305
	//	Если Номенклатура.ВидНоменклатуры <> Справочники.ВидыНоменклатуры.Фурнитура Тогда
	//		возврат;
	//	КонецЕсли;
	//	//Бурлаков М.Б. - конец		
	//КонецЕсли;
	
	
	ДвижениеПоПретензии=Движения.КСП_Претензии.Добавить();
	ДвижениеПоПретензии.Период=Дата;
	ДвижениеПоПретензии.Регистратор=Ссылка;
	ДвижениеПоПретензии.Номенклатура=Номенклатура;
	ДвижениеПоПретензии.Характеристика=Характеристика;
	ДвижениеПоПретензии.Документ=ДокументОснование;
	ДвижениеПоПретензии.КоличествоПоставщика=ЭтотОбъект.Товары.итог("КоличествоПоставщика");
	ДвижениеПоПретензии.КоличествоФакт=ЭтотОбъект.Товары.итог("Количество");
	ДвижениеПоПретензии.КоличествоБрак=ЭтотОбъект.Товары.итог("КоличествоБрак");
	ПроцентПоКоличеству=0;
	Если ДвижениеПоПретензии.КоличествоФакт<ДвижениеПоПретензии.КоличествоПоставщика Тогда
		ПроцентПоКоличеству=100-Окр(ДвижениеПоПретензии.КоличествоФакт*100/ДвижениеПоПретензии.КоличествоПоставщика,1);
	КонецЕсли; 
	СуммаПоставшика=ПолучитьСуммуПоступленияПоНоменклатуре(Номенклатура,Характеристика,ДвижениеПоПретензии.КоличествоПоставщика);
	
	//Если ДокументОснование.СпецТипНакладной=Перечисления.СпецТипНакладной.ПряжаЛот Тогда
	Если СпецТипНакладной=Перечисления.КСП_СпецТипНакладной.ПряжаЛот Тогда
		ДопустимыйМинимум=ДвижениеПоПретензии.КоличествоПоставщика*(1-ПроцентКондиции/100);
		ПроцентКолОтОбщегоКондиционногоОбъема=Окр(100-ДвижениеПоПретензии.КоличествоФакт*100/ДопустимыйМинимум,1);
		Если ДвижениеПоПретензии.КоличествоПоставщика<200 Тогда
			Если ПроцентКолОтОбщегоКондиционногоОбъема>1.5 и Окр(СуммаПоставшика*ПроцентКолОтОбщегоКондиционногоОбъема/100,2)>7000 Тогда
				Если Дата>'20161026' Тогда
					ПретензияПроцПоКоличеству=Макс(0,ПроцентКолОтОбщегоКондиционногоОбъема);
				иначе
					ПретензияПроцПоКоличеству=Макс(0,ПроцентПоКоличеству-Номенклатура.ДопустимыйПроцентПоКоличеству);
				КонецЕсли; 
			иначе
				ПретензияПроцПоКоличеству=0;
			КонецЕсли; 
		иначе
			Если ПроцентКолОтОбщегоКондиционногоОбъема>1.5 и Окр(СуммаПоставшика*ПроцентКолОтОбщегоКондиционногоОбъема/100,2)>15000 Тогда
				Если Дата>'20161026' Тогда
					ПретензияПроцПоКоличеству=Макс(0,ПроцентКолОтОбщегоКондиционногоОбъема);
				иначе
					ПретензияПроцПоКоличеству=Макс(0,ПроцентПоКоличеству-Номенклатура.ДопустимыйПроцентПоКоличеству);
				КонецЕсли; 
			иначе
				ПретензияПроцПоКоличеству=0;
			КонецЕсли; 
		КонецЕсли; 
	иначе
		Если ПроцентПоКоличеству>2 и Окр(СуммаПоставшика*ПроцентПоКоличеству/100,2)>15000 Тогда
			ПретензияПроцПоКоличеству=Макс(0,ПроцентПоКоличеству-Номенклатура.ДопустимыйПроцентПоКоличеству);
		иначе
			ПретензияПроцПоКоличеству=0;
		КонецЕсли; 
	КонецЕсли; 
	
	ДвижениеПоПретензии.СуммаПоставшика=СуммаПоставшика;
	ДвижениеПоПретензии.СуммаПретензииПоКоличеству=Окр(СуммаПоставшика*ПретензияПроцПоКоличеству/100,2);
	
	
	ДвижениеРегСведений=Движения.КСП_ДанныеПоПретензиям.Добавить();
	ДвижениеРегСведений.Период=Дата;
	ДвижениеРегСведений.Регистратор=Ссылка;
	ДвижениеРегСведений.Номенклатура=Номенклатура;
	ДвижениеРегСведений.Характеристика=Характеристика;
	ДвижениеРегСведений.Документ=ДокументОснование;
	ДвижениеРегСведений.ПроцентПоКоличеству=ПроцентПоКоличеству;
	ДвижениеРегСведений.СтатусПретензии=Справочники.КСП_СтатусыПретензии.ОформленПриходСкладом;
	
		
КонецПроцедуры
