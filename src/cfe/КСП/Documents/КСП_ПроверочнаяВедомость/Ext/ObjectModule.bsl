		Если Завершена тогда
			//Если Не ПроверкаНаСоответствиеПриходнойНакладной() тогда
			//	Сообщить("Данные по кол-ву в приходном ордере не совпадают с ко-вом в приходной накладной или приходная накладная не создана!");
			//	Отказ=Истина;
			//	Завершена=Ложь;
			//	РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
			//	возврат;
			//КонецЕсли;
			
			ФлагВведенПрихНакл=Истина;
			ДокПоступление=ДокументОснование.Распоряжение;
			Если Не ЗначениеЗаполнено(ДокПоступление) Тогда
