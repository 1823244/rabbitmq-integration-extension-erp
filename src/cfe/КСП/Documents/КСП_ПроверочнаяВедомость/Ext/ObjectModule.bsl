Функция ПолучитьТаблицуДвиженийПоРегиструСведенияОПроверкеЗакупаемойНоменклатуры()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроверочнаяВедомостьТовары.Номенклатура КАК Номенклатура,
		|	ПроверочнаяВедомостьТовары.Характеристика КАК ХарактеристикаНоменклатуры,
		|	ПроверочнаяВедомостьТовары.Ссылка.ДокументОснование КАК ПриходныйОрдер,
		|	ПроверочнаяВедомостьТовары.Количество * ПроверочнаяВедомостьТовары.Коэффициент КАК Количество,
		|	ПроверочнаяВедомостьТовары.Ссылка КАК Регистратор,
		|	ПроверочнаяВедомостьТовары.Ссылка.Дата КАК Период,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	Документ.КСП_ПроверочнаяВедомость.Товары КАК ПроверочнаяВедомостьТовары
		|ГДЕ
		|	ПроверочнаяВедомостьТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

