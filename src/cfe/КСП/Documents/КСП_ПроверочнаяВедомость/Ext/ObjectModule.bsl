				Характеристика = СтрокаПО.Характеристика;	
				//Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		Если Завершена и Не Ссылка.Завершена=Завершена Тогда
			ДатаЗавершена=ТекущаяДата();
		КонецЕсли; 
	КонецЕсли;
	//**** Алекс Ц.
	Если Дата>Дата(2010,07,01) И РежимЗаписи=РежимЗаписиДокумента.Проведение И НЕ Завершена Тогда
		РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
