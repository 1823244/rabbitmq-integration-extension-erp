Функция ПроверкаНаРазмещениеАдресныйСклад(ВыводитьПредупреждения=Истина) экспорт
	//18-07-2015 Водолазова
	СкладДляПоступления=?(ЗначениеЗаполнено(Склад),Склад,ДокументОснование.Склад);
	Если СкладДляПоступления.ИспользоватьАдресноеХранение и СкладДляПоступления.ДатаНачалаАдресногоХраненияОстатков<=Дата и Не СпецТипНакладной=Перечисления.СпецТипНакладной.ПряжаЛот Тогда
		Запрос = Новый Запрос;	
		Запрос.Текст="ВЫБРАТЬ
		|	ОтборРазмещениеТоваров.Ссылка КАК ДокОтборРазмещение
		|ИЗ
		|	Документ.ОтборРазмещениеТоваров КАК ОтборРазмещениеТоваров
		|ГДЕ
		|	ОтборРазмещениеТоваров.Проведен
		|	И ОтборРазмещениеТоваров.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок)
		|	И ОтборРазмещениеТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОтбораРазмещенияТоваров.Размещение)
		|	И ОтборРазмещениеТоваров.Распоряжение = &Распоряжение";
		
		Запрос.УстановитьПараметр("Распоряжение",Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Если ВыводитьПредупреждения Тогда
				#Если Клиент Тогда
					Предупреждение("Невозможно провести документ. Склад хранения сырья с адресным хранением. Необходимо произвести размещение товаров");
				#КонецЕсли
				Сообщить("Невозможно провести документ. Склад хранения сырья с адресным хранением. Необходимо произвести размещение товаров");
			КонецЕсли; 
			Возврат Ложь;
		иначе
			//Если есть ошибка
			Если Выборка.ДокОтборРазмещение.ПолучитьОбъект().КорректностьОтборИРазмещение() тогда
				Если ВыводитьПредупреждения Тогда
					#Если Клиент Тогда
						Предупреждение("Невозможно провести документ. Склад хранения сырья с адресным хранением. Документ отбор и размещение не соответсвует по кол-ву распоряжению!",60);
					#КонецЕсли
					Сообщить("Невозможно провести документ. Склад хранения сырья с адресным хранением. Документ отбор и размещение не соответсвует по кол-ву распоряжению!");
				КонецЕсли; 
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	возврат Истина;
КонецФункции // ()
Функция ПолучитьСуммуПоступленияПоНоменклатуре(Номенклатура,Характеристика,КоличествоПоставщика=0) Экспорт
	ДокПоступления=ДокументОснование.ПолучитьОбъект().Распоряжение;
	Если Не ЗначениеЗаполнено(ДокПоступления) тогда
		возврат 0;
	КонецЕсли;
	СтрОтбора=новый Структура;
	СтрОтбора.Вставить("Номенклатура",Номенклатура);
	СтрОтбора.Вставить("Характеристика",Характеристика);
	Если ТипЗнч(ДокПоступления)=Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		НайдСтроки=ДокПоступления.Товары.НайтиСтроки(СтрОтбора);
	иначеЕсли ТипЗнч(ДокПоступления)=Тип("ДокументСсылка.ПоступлениеТоваровИзПереработки") Тогда
		возврат 0;
	КонецЕсли; 
	СуммаПоставщика=0;
	Для каждого ТекНайдСтрока Из НайдСтроки Цикл
		Если ЗначениеЗаполнено(КоличествоПоставщика) и Не КоличествоПоставщика=ТекНайдСтрока.Количество Тогда
			продолжить;	
		КонецЕсли; 
		Если НЕ ДокПоступления.ЦенаВключаетНДС Тогда
			СуммаПоставщика=СуммаПоставщика+ТекНайдСтрока.Сумма+ТекНайдСтрока.СуммаНДС;
		иначе
			СуммаПоставщика=СуммаПоставщика+ТекНайдСтрока.Сумма;
		КонецЕсли; 
	КонецЦикла; 
	Если НЕ ДокПоступления.Валюта=Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		СуммаПоставщика = ОбщегоНазначения.ПересчитатьИзВалютыВВалюту(СуммаПоставщика,  ДокПоступления.Валюта,Константы.ВалютаРегламентированногоУчета.Получить(),
				   ДокПоступления.КурсЧислитель, 1,1,1);
	КонецЕсли; 
	возврат СуммаПоставщика;
КонецФункции

