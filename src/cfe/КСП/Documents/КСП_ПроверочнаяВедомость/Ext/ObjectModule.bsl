	//		Отказ=Истина;
	//		возврат;
	//	КонецЕсли;
	//КонецЕсли;
	//}Курдюмов А.Н.  
	Если ТипЗнч(ДокументОснование.Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Если Не Контрагент=ДокументОснование.Распоряжение.Контрагент тогда
			Контрагент=ДокументОснование.Распоряжение.Контрагент;
		КонецЕсли;
	КонецЕсли;
	Если НовыйМеханизмПрихода  Тогда
		Если Не Дата>ДокументОснование.Дата Тогда
			Дата=ДокументОснование.Дата+1;
		КонецЕсли; 
