			Завершена=Ложь;
			Отказ=Истина;
		КонецЕсли;
	КонецЕсли; 
	
	
	//{ it_1c3 Гадецкий 25072014
	Если ЭтоНовый() тогда
		Если Завершена Тогда
			ДатаЗавершена=ТекущаяДата();
		КонецЕсли; 
	Иначе	
		СтрокаПО = ДокументОснование.Товары.Найти(ЭтотОбъект.Ссылка,"КСП_ПроверочнаяВедомость");		
