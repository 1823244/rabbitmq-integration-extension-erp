	//			ОтветственныйМенеджер=ДокументОснование.ОтветственныйМенеджерСнабжения;
	//		иначе
	//			ОтветственныйМенеджер=ДокументОснование.ДокументФактПрихода.Ответственный;
	//		КонецЕсли;
