	ФотоДефектовПутьКФайлуПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПунктыПроверкиВизуальногоОсмотраПунктПроверкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтрокаТекущиеДанные = Элементы.ПунктыПроверкиВизуальногоОсмотра.ТекущиеДанные;
	Если СтрокаТекущиеДанные.ПунктПроверки.АвтоматическиВключатьВЧекЛисты Тогда
		Сообщить("Этот пункт проверки был включен в чек лист автоматически. Удалению и изменению не подлежит", СтатусСообщения.Внимание);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольнаяПеремоткаПунктПроверкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтрокаТекущиеДанные = Элементы.КонтрольнаяПеремотка.ТекущиеДанные;
	Если СтрокаТекущиеДанные.ПунктПроверки.АвтоматическиВключатьВЧекЛисты Тогда
		Сообщить("Этот пункт проверки был включен в чек лист автоматически. Удалению и изменению не подлежит", СтатусСообщения.Внимание);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаВыполненияЧекЛистаПоЭтапу(КлючСтроки, Этап)
	ЧекЛистВыполнен = Истина;
	
	Запрос = Новый Запрос;
	Если Этап = Перечисления.КСП_ЭтапыПроверкиКачестваПоЧекЛистам.ВизуальныйКонтроль Тогда   	
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЧекЛистПроверкиКачестваПряжиПунктыПроверкиВизуальногоОсмотра.ПунктПроверки,
			|	ЧекЛистПроверкиКачестваПряжиПунктыПроверкиВизуальногоОсмотра.РезультатПроверки,
			|	ЧекЛистПроверкиКачестваПряжиПунктыПроверкиВизуальногоОсмотра.КлючСтроки
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&ПунктыПроверкиВизуальногоОсмотра КАК ЧекЛистПроверкиКачестваПряжиПунктыПроверкиВизуальногоОсмотра
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.ПунктПроверки,
			|	ВТ.РезультатПроверки,
			|	ВТ.КлючСтроки
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.РезультатПроверки = ЛОЖЬ
			|	И ВТ.КлючСтроки = &КлючСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВТ";
		
		Запрос.УстановитьПараметр("ПунктыПроверкиВизуальногоОсмотра", Объект.ПунктыПроверкиВизуальногоОсмотра.Выгрузить());
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЧекЛистПроверкиКачестваПряжиКонтрольнаяПеремотка.ПунктПроверки,
			|	ЧекЛистПроверкиКачестваПряжиКонтрольнаяПеремотка.РезультатПроверки,
			|	ЧекЛистПроверкиКачестваПряжиКонтрольнаяПеремотка.КлючСтроки
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&КонтрольнаяПеремотка КАК ЧекЛистПроверкиКачестваПряжиКонтрольнаяПеремотка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.ПунктПроверки,
			|	ВТ.РезультатПроверки,
			|	ВТ.КлючСтроки
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.РезультатПроверки = НЕОПРЕДЕЛЕНО
			|	И ВТ.КлючСтроки = &КлючСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВТ";
		
		Запрос.УстановитьПараметр("КонтрольнаяПеремотка", Объект.КонтрольнаяПеремотка.Выгрузить());		
	КонецЕсли;
	Запрос.УстановитьПараметр("КлючСтроки", КлючСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЧекЛистВыполнен = Ложь;
		Сообщить("Пункт проверки " + ВыборкаДетальныеЗаписи.ПунктПроверки + " не был выполнен. Установка признака завершения этапа контроля невозможна.", СтатусСообщения.Внимание);
	КонецЦикла;
	
	Возврат ЧекЛистВыполнен;
КонецФункции

&НаКлиенте
Процедура ТоварыВизуальныйОсмотрПроверкаЗавершенаПриИзменении(Элемент)
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;	
	Если СтрокаТекущиеДанные.ВизуальныйОсмотрПроверкаЗавершена Тогда
		Если Не ПроверкаВыполненияЧекЛистаПоЭтапу(СтрокаТекущиеДанные.КлючСтроки, 
			ПредопределенноеЗначение("Перечисление.КСП_ЭтапыПроверкиКачестваПоЧекЛистам.ВизуальныйКонтроль")) Тогда
			СтрокаТекущиеДанные.ВизуальныйОсмотрПроверкаЗавершена = Ложь;
			Возврат;
		КонецЕсли;
		СтрокаТекущиеДанные.ВизуальныйОсмотрДатаЗавершенияПроверки = ТекущаяДата();
	Иначе
		СтрокаТекущиеДанные.ВизуальныйОсмотрДатаЗавершенияПроверки = "";
	КонецЕсли;
	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКонтрольнаяПеремоткаПроверкаЗавершенаПриИзменении(Элемент)
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	Если СтрокаТекущиеДанные.КонтрольнаяПеремоткаПроверкаЗавершена Тогда
		Если Не ПроверкаВыполненияЧекЛистаПоЭтапу(СтрокаТекущиеДанные.КлючСтроки,
			ПредопределенноеЗначение("Перечисление.КСП_ЭтапыПроверкиКачестваПоЧекЛистам.КонтрольнаяПеремотка")) Тогда
			СтрокаТекущиеДанные.КонтрольнаяПеремоткаПроверкаЗавершена = Ложь;
			Возврат;
		КонецЕсли;
		СтрокаТекущиеДанные.КонтрольнаяПеремоткаДатаЗавершенияПроверки = ТекущаяДата();
	Иначе
		СтрокаТекущиеДанные.КонтрольнаяПеремоткаДатаЗавершенияПроверки = "";
	КонецЕсли;
	УстановитьДоступность();
КонецПроцедуры
