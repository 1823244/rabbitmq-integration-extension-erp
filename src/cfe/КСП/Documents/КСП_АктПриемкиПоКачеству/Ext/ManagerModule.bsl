//Бурлаков М.Б. - конец         
//Бурлаков М.Б. - начало
Функция ТипЗначенияСтр(Знач Объект) Экспорт 	
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		СписокТипов = Новый Массив;
		СписокВидов = Новый Массив;
		Для Каждого ТекОбъект Из Объект Цикл
			ТипСтр = ТипЗначенияСтр(ТекОбъект);
			Если СписокТипов.Найти(ТипСтр.Тип) = Неопределено Тогда
				СписокТипов.Добавить(ТипСтр.Тип);
			КонецЕсли;
			Если СписокВидов.Найти(ТипСтр.Вид) = Неопределено Тогда
				СписокВидов.Добавить(ТипСтр.Вид);
			КонецЕсли;
		КонецЦикла;
		
		Результат = Новый Структура;
		Результат.Вставить("Тип","");
		Результат.Вставить("Вид","");
		
		Если СписокТипов.Количество() = 1 Тогда
			Результат.Тип = СписокТипов[0];
			Если СписокВидов.Количество() = 1 Тогда
				Результат.Вид = СписокВидов[0];
			КонецЕсли;
		Иначе
			Результат.Тип = "Неопределенный";
		КонецЕсли; 			
	Иначе
		Если ТипЗнч(Объект) = Тип("Тип") Тогда
			ТипЗначения = Объект;
			Объект = Метаданные.НайтиПоТипу(Объект);
			
		ИначеЕсли ТипЗнч(Объект) = Тип("ОписаниеТипов") Тогда
			Результат = ТипЗначенияСтр(Объект.Типы());
			Возврат Результат;
			
		ИначеЕсли ТипЗнч(Объект) <> Тип("ОбъектМетаданных") Тогда
			ТипЗначения = ТипЗнч(Объект);
			Объект = Метаданные.НайтиПоТипу(ТипЗначения);
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("Тип","");
		Результат.Вставить("Вид","");

		Если Объект <> Неопределено Тогда
			Если Метаданные.Справочники.Содержит(Объект) Тогда
			    Результат.Тип = "Справочник";
			ИначеЕсли Метаданные.Документы.Содержит(Объект) Тогда
			    Результат.Тип = "Документ";
			ИначеЕсли Метаданные.Перечисления.Содержит(Объект) Тогда
			    Результат.Тип = "Перечисление";
			ИначеЕсли Метаданные.Отчеты.Содержит(Объект) Тогда
			    Результат.Тип = "Отчет";
			ИначеЕсли Метаданные.Обработки.Содержит(Объект) Тогда
			    Результат.Тип = "Обработка";
			ИначеЕсли Метаданные.ЖурналыДокументов.Содержит(Объект) Тогда
			    Результат.Тип = "ЖурналДокументов"; //Или Журналы документов?
			ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(Объект) Тогда
			    Результат.Тип = "ПланВидовХарактеристик"; //Или Планы видов характеристик?
			ИначеЕсли Метаданные.ПланыСчетов.Содержит(Объект) Тогда
			    Результат.Тип = "ПланСчетов"; //Или Планы счетов?
			ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(Объект) Тогда
			    Результат.Тип = "ПланВидовРасчета"; //Или Планы видов расчета?
			ИначеЕсли Метаданные.РегистрыСведений.Содержит(Объект) Тогда
			    Результат.Тип = "РегистрСведений"; //Или Регистры сведений?
			ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Объект) Тогда
			    Результат.Тип = "РегистрНакопления"; //Или Регистры накопления?
			ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(Объект) Тогда
			    Результат.Тип = "РегистрБухгалтерии"; //Или Регистры бухгалтерии?
			ИначеЕсли Метаданные.РегистрыРасчета.Содержит(Объект) Тогда
			    Результат.Тип = "РегистрРасчета"; //Или Регистры расчета?
			ИначеЕсли Метаданные.БизнесПроцессы.Содержит(Объект) Тогда
			    Результат.Тип = "БизнесПроцесс"; //Или Бизнес-процессы?
			ИначеЕсли Метаданные.Задачи.Содержит(Объект) Тогда
			    Результат.Тип = "Задача"; //Или Задачи?
			КонецЕсли;
			Результат.Вид = Объект.Имя;
		Иначе
			Результат.Тип = Строка(ТипЗначения);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции

