&НаКлиенте
Процедура ПредварительныйПросмотр(Команда)
	Элементы.ТехХарактеристикиПредварительныйПросмотр.Пометка = Не Элементы.ТехХарактеристикиПредварительныйПросмотр.Пометка;
	Элементы.ПредпросмотрФайла.Видимость = Элементы.ТехХарактеристикиПредварительныйПросмотр.Пометка;
	ТехХарактеристикиПутьКФайлуПриИзменении(Неопределено);
КонецПроцедуры

&НаСервере
Функция ПроверкаНаличияЧекЛистаПоОснованию()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧекЛистПроверкиКачестваТестовыхОтвязов.Ссылка
		|ИЗ
		|	Документ.КСП_ЧекЛистПроверкиКачестваТестовыхОтвязов КАК ЧекЛистПроверкиКачестваТестовыхОтвязов
		|ГДЕ
		|	ЧекЛистПроверкиКачестваТестовыхОтвязов.ДокументОснование = &ДокументОснование
		|	И ЧекЛистПроверкиКачестваТестовыхОтвязов.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("На основании документа " + Объект.ДокументОснование + " уже был создан " + ВыборкаДетальныеЗаписи.Ссылка + ". Необходимо работать в уже существующем документе", СтатусСообщения.Важное);
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь; 
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Сообщить("Документ должен быть введен на основании чек листа проверки качества пряжи", СтатусСообщения.Важное);
		Отказ = Истина;
	Иначе
		Отказ = ПроверкаНаличияЧекЛистаПоОснованию();
	КонецЕсли;
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Объект.ПлановаяДатаЗавершенияПретензионнойРаботы = БюджетированиеКлиентСервер.ДобавитьДень(Объект.ДатаПоступления, 15);
	КонецЕсли;  
	Элементы.ПредпросмотрФайла.Видимость = Элементы.ТехХарактеристикиПредварительныйПросмотр.Пометка;
	ПутьКПапкеИзображенийПоЧекЛистамПроверкиКачестваТестовыхОтвязов = Константы.КСП_ПутьКПапкеИзображенийПоЧекЛистамПроверкиКачестваТестовыхОтвязов.Получить();
	ПутьКПапкеТХПоПряже = Константы.КСП_ПутьКПапкеТХПоПряже.Получить(); 
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаОснованииНаСервере(Основание)
	ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.ЧекЛистПроверкиКачестваТестовыхОтвязов"));
	ДокументОбъект.Заполнить(Основание);
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОснованию(Команда)
	Ответ = Вопрос("Заполнить документ на основании документа " + Объект.ДокументОснование + "?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ДокументОснование.Пустая() Тогда
		Сообщить("Сначала необходимо выбрать документ основание", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	ЗаполнитьНаОснованииНаСервере(Объект.ДокументОснование);
	ТоварыПриАктивизацииСтроки(Неопределено);
	Изображение = "";
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность()
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	Элементы.КонтрольКачества.ТолькоПросмотр = СтрокаТекущиеДанные.ПроверкаЗавершена;
	Элементы.ФотоДефектов.ТолькоПросмотр = СтрокаТекущиеДанные.ПроверкаЗавершена;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	КлючСтроки = СтрокаТекущиеДанные.КлючСтроки;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", КлючСтроки);
	Элементы.КонтрольКачества.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Ответ = Вопрос("Данные документа будует перезаполнены. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	Если ПроверкаНаличияЧекЛистаПоОснованию() Тогда
		Объект.ДокументОснование = "";
	КонецЕсли;
	ЗаполнитьНаОснованииНаСервере(Объект.ДокументОснование);
КонецПроцедуры

&НаСервере
Процедура УдалитьФотоПоКлючу(КлючСтроки)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧекЛистПроверкиКачестваПряжиФотоДефектов.ПутьКФайлу,
		|	ЧекЛистПроверкиКачестваПряжиФотоДефектов.КлючСтроки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ФотоДефектов КАК ЧекЛистПроверкиКачестваПряжиФотоДефектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ПутьКФайлу,
		|	ВТ.КлючСтроки
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.КлючСтроки <> &КлючСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ";
	
	Запрос.УстановитьПараметр("КлючСтроки", КлючСтроки);
	Запрос.УстановитьПараметр("ФотоДефектов", Объект.ФотоДефектов.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Объект.ФотоДефектов.Очистить();
	Объект.ФотоДефектов.Загрузить(РезультатЗапроса.Выгрузить());
	Изображение = "";
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваПриАктивизацииСтроки(Элемент)
	СтрокаТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	Изображение = "";
	КлючСтроки = СтрокаТекущиеДанные.КлючСтрокиДляСвязиСФото;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтрокиДляСвязиСФото", КлючСтроки);
	Элементы.ФотоДефектов.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
		Сообщить("Заполните таблицу ""Товары"" слева через функционал заполнения на основании", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваПередНачаломИзменения(Элемент, Отказ)
	Если Элемент.Имя = "КонтрольКачестваПунктПроверки" Тогда
		СтрокаТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
		Отказ = СтрокаТекущиеДанные.ПунктПроверки.АвтоматическиВключатьВЧекЛисты;
		Если Отказ Тогда
			Сообщить("Этот пункт чек листа изменять нельзя", СтатусСообщения.Внимание);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваПередУдалением(Элемент, Отказ)
	СтрокаТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
	Отказ = СтрокаТекущиеДанные.ПунктПроверки.АвтоматическиВключатьВЧекЛисты;
	Если Отказ Тогда
		Сообщить("Этот пункт чек листа удалять нельзя", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	КлючСтроки = СтрокаТекущиеДанные.КлючСтрокиДляСвязиСФото;
	Отбор = Новый Структура;
	Отбор.Вставить("КлючСтроки", КлючСтроки);
	ФотоДефектов = Объект.ФотоДефектов.НайтиСтроки(Отбор);
	Если ФотоДефектов.Количество() > 0 Тогда
		Ответ = Вопрос("По этому пункту чек листа существуют фото дефектов. При установке признака они будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Отказ = Истина;
			Возврат;
		Иначе
			УдалитьФотоПоКлючу(КлючСтроки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИзображение(ПутьКФайлу, Файл)
	Попытка
		Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
			Изображение = ПоместитьВоВременноеХранилище(Новый Картинка(Файл), УникальныйИдентификатор);
		Иначе
			Изображение = ПоместитьВоВременноеХранилище(Новый Картинка, УникальныйИдентификатор);
		КонецЕсли;	
	Исключение
		Сообщить("Файл не найден. Возможно он был перемещен или удален", СтатусСообщения.Внимание);
	КонецПопытки;	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
		Сообщить("Необходимо выбрать конкретную строку с номенклатурой в таблице слева", СтатусСообщения.Внимание);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	ТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.КлючСтроки) или НоваяСтрока Тогда
		ТекущиеДанные.КлючСтроки = СтрокаТекущиеДанные.КлючСтроки;  	
		ТекущиеДанные.КлючСтрокиДляСвязиСФото = Новый УникальныйИдентификатор;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФотоДефектовПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.ФотоДефектов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Файл = ПутьКПапкеИзображенийПоЧекЛистамПроверкиКачестваТестовыхОтвязов + СтрЗаменить(ТекущиеДанные.ПутьКФайлу, ".\\", "\");
	ПоказатьИзображение(ТекущиеДанные.ПутьКФайлу, Файл);
КонецПроцедуры

&НаКлиенте
Процедура ФотоДефектовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ФотоДефектовПутьКФайлуПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ФотоДефектовПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Сообщить("Необходимо выбрать конкретную строку в таблице контроля качества", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ФотоДефектов.ТекущиеДанные;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПредварительныйПросмотр = Истина;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл изображения дефекта";
	ДиалогОткрытияФайла.Каталог = ПутьКПапкеИзображенийПоЧекЛистамПроверкиКачестваТестовыхОтвязов;
	ДиалогОткрытияФайла.Фильтр = 
		"Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.wmf;*.emf|" 
		+ "Формат bmp (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
		+ "Формат JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
		+ "Формат TIFF (*.tif)|*.tif|"
		+ "Формат GIF (*.gif)|*.gif|"
		+ "Формат PNG (*.png)|*.png|"
		+ "Формат метафайл (*.wmf;*.emf)|*.wmf;*.emf|"; // картинки

	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Каталог = РаботаСФайламиКлиент.СоздатьИлиНайтиКаталог(ПутьКПапкеИзображенийПоЧекЛистамПроверкиКачестваТестовыхОтвязов);	 
		Если Каталог=неопределено тогда
			Возврат;
		Конецесли;
		Файл=ДиалогОткрытияФайла.ПолноеИмяФайла ;
		ТекущиеДанные.ПутьКФайлу = ".\" + Прав(Файл, СтрДлина(Файл) - СтрДлина(Каталог));
		ТекущиеДанные.КлючСтроки = СтрокаТекущиеДанные.КлючСтроки;
		ТекущиеДанные.КлючСтрокиДляСвязиСФото = СтрокаТекущиеДанные.КлючСтрокиДляСвязиСФото;
		ПоказатьИзображение(ТекущиеДанные.ПутьКФайлу, Файл);
		КонтрольКачестваПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФотоДефектовПутьКФайлуПриИзменении(Элемент)
	ФотоДефектовПриАктивизацииСтроки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОтклонение()
	СтрокаТекущиеДанные = Элементы.КонтрольКачества.ТекущиеДанные;
	
	Если СтрокаТекущиеДанные = Неопределено
			ИЛИ ТипЗнч(СтрокаТекущиеДанные.Норматив) <> Тип("Число")
			или ТипЗнч(СтрокаТекущиеДанные.Факт) <> Тип("Число") Тогда
			
		Возврат;
		
	КонецЕсли;
	
	Если СтрокаТекущиеДанные.Факт = 0 Тогда
		
		СтрокаТекущиеДанные.Отклонение = 0;
		
	Иначе
		
		СтрокаТекущиеДанные.Отклонение = (СтрокаТекущиеДанные.Факт - СтрокаТекущиеДанные.Норматив) * 100 / СтрокаТекущиеДанные.Факт;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваНормативПриИзменении(Элемент)
	РассчитатьОтклонение();
КонецПроцедуры

&НаКлиенте
Процедура КонтрольКачестваФактПриИзменении(Элемент)
	РассчитатьОтклонение();
КонецПроцедуры

&НаСервере
Функция ПолучитьСотрудникаПоТекущемуПользователю()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СотрудникиОрганизаций.Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК СотрудникиОрганизаций
		|ГДЕ
		|	СотрудникиОрганизаций.ФизическоеЛицо = &Физлицо
		|	И СотрудникиОрганизаций.ПометкаУдаления = ЛОЖЬ
		|	И СотрудникиОрганизаций.ГоловнаяОрганизация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Физлицо", ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.СотрудникиОрганизаций.ПустаяСсылка();
КонецФункции

