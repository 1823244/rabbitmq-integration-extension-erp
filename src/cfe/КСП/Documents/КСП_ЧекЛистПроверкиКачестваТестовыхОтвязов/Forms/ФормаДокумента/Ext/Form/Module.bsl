		Объект.ПлановаяДатаЗавершенияПретензионнойРаботы = БюджетированиеКлиентСервер.ДобавитьДень(Объект.ДатаПоступления, 15);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаВыполненияЧекЛиста(КлючСтроки)
	ЧекЛистВыполнен = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЧекЛистПроверкиКачестваТестовыхОтвязовКонтрольКачества.ПунктПроверки,
		|	ЧекЛистПроверкиКачестваТестовыхОтвязовКонтрольКачества.Факт,
		|	ЧекЛистПроверкиКачестваТестовыхОтвязовКонтрольКачества.КлючСтроки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&КонтрольКачества КАК ЧекЛистПроверкиКачестваТестовыхОтвязовКонтрольКачества
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ПунктПроверки
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.КлючСтроки = &КлючСтроки
		|	И ВТ.Факт = НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ";
	
	Запрос.УстановитьПараметр("КлючСтроки", КлючСтроки);
	Запрос.УстановитьПараметр("КонтрольКачества", Объект.КонтрольКачества.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЧекЛистВыполнен = Ложь;
		Сообщить("Пункт проверки " + ВыборкаДетальныеЗаписи.ПунктПроверки + " не был выполнен. Установка признака завершения проверки невозможна.", СтатусСообщения.Внимание);
	КонецЦикла;
	
	Возврат ЧекЛистВыполнен;
КонецФункции

&НаКлиенте
Процедура ТоварыПроверкаЗавершенаПриИзменении(Элемент)
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Возврат;		
	КонецЕсли;
	Если СтрокаТекущиеДанные.ПроверкаЗавершена Тогда
		Если Не ПроверкаВыполненияЧекЛиста(СтрокаТекущиеДанные.КлючСтроки) Тогда
			СтрокаТекущиеДанные.ПроверкаЗавершена = Ложь;
			Возврат;
		КонецЕсли;
		СтрокаТекущиеДанные.ДатаЗавершенияПроверки = ТекущаяДата();
	Иначе
		СтрокаТекущиеДанные.ДатаЗавершенияПроверки = "";
	КонецЕсли;
	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Function ExcelToPDF(file) //file - полный путь файла .xls созданный средствами 1с
	
	Попытка
        Excel =  new  COMObject("Excel.Application");
    Исключение
        Сообщить("Не удалось преобразовать в pdf!!!");
        file="";
    КонецПопытки;
    Попытка  
        Excel.Workbooks.Open(file);
        Excel.ActiveSheet.PageSetup.zoom=false; //уместим на одной странице в ширину
        Excel.ActiveSheet.PageSetup.FitToPagesWide = 1; //уместим на одной странице в ширину
        Excel.ActiveSheet.PageSetup.FitToPagesTall = 10; //и на 10 в длину        
		ТекущиеДанные = Элементы.ТехХарактеристики.ТекущиеДанные;
		ВремФайл = КаталогВременныхФайлов() + СтрЗаменить(ТекущиеДанные.ПутьКФайлу, ".\\", "");
		file=лев(ВремФайл,стрдлина(ВремФайл)-4)+".pdf"; //подменяем раширение
		Excel.ActiveWorkbook.ExportAsFixedFormat(0, File,0,false,false,,,false,); //сохраняем в pdf 
        //0-pdf, file-полный путь файла, 0 - стандартное качество
        Excel.Quit(); // закрываем Excel
    Исключение
        Excel.Quit();
        Сообщить("Не удалось преобразовать в pdf!!!");
        file="";
	КонецПопытки;
	
    возврат file;
	
EndFunction

&НаКлиенте
Function WordToPDF(file) //file - полный путь файла .xls созданный средствами 1с
	
	Попытка
		Word = Новый COMОбъект("Word.Application");
		Document = Word.Documents.Open(file);
		file = ПолучитьИмяВременногоФайла("PDF");
		Document.SaveAs(file,17);
		Word.Quit();
	Исключение
		Word.Quit();
		Сообщить(ОписаниеОшибки());
		Сообщить("Не удалось преобразовать в pdf!!!");
		file="";
	КонецПопытки;
	
	Возврат file; 	
EndFunction

&НаКлиенте
Процедура РазместитьФайлВПолеHTML(ФайлыТекСтрока)	
	Если ФайлыТекСтрока=неопределено тогда
		ПредпросмотрФайла="";
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ФайлыТекСтрока.ПутьКФайлу) тогда
		ПредпросмотрФайла="";
		Возврат;
	КонецЕсли;	
	ИмяВременногоФайла = ПутьКПапкеТХПоПряже + СтрЗаменить(ФайлыТекСтрока.ПутьКФайлу, ".\\", "\"); 	
	Ф = Новый Файл(ИмяВременногоФайла);	
	Если Найти("*.xls;*.xlsx", НРег(Ф.Расширение)) > 0 Тогда		
		Если  ложь тогда //windows7 гавно
			ПредпросмотрФайла="";
		Иначе
			ВременныйФайл = ExcelToPDF(ИмяВременногоФайла);
			ПредпросмотрФайла=ВременныйФайл;			
		КонецЕсли;		
	ИначеЕсли Найти("*.doc;*.docx", НРег(Ф.Расширение)) > 0 Тогда		
		Если  ложь тогда //windows7 гавно
			ПредпросмотрФайла="";
		Иначе			
			ВременныйФайл = WordToPDF(ИмяВременногоФайла);
			ПредпросмотрФайла=ВременныйФайл;			
		КОнецЕсли;		
	ИначеЕсли Найти("*.asf;*.wma;*.wmv;*.avi;*.wav;*.mpeg;*.mp3;*.midi;*.aiff;*.au;*.flac;*.ogg", НРег(Ф.Расширение)) > 0 и ЛОЖЬ Тогда
		Текст_ТабличныйДокументКартинка = "<HTML><BODY>
		|<OBJECT id=WMP classid='CLSID:22D6f312-B0F6-11D0-94AB-0080C74C7E95' width='100%' height='100%'> 
		|</OBJECT></BODY></HTML>";		
		ПредпросмотрФайла=Текст_ТабличныйДокументКартинка;
	ИначеЕсли Найти("*.pdf", НРег(Ф.Расширение)) > 0 Тогда
		ПредпросмотрФайла=ИмяВременногоФайла;
	Иначе                         		
		ПредпросмотрФайла = "<HTML><BODY>Откройте файл вручную с помощью кнопки ""Открыть"" на командной панели табличной части ""Тех. характеристики от поставщика""</BODY></HTML>";		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТехХарактеристикиПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтрокаТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТекущиеДанные = Неопределено Тогда
		Сообщить("Необходимо выбрать конкретную строку в таблице ""Товары""", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТехХарактеристики.ТекущиеДанные;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПредварительныйПросмотр = Истина;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл технических характеристик";
	ДиалогОткрытияФайла.Каталог = ПутьКПапкеТХПоПряже;
	ДиалогОткрытияФайла.Фильтр = РаботаСФайламиКлиент.ПолучитьФильтрФайлов();		

	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Каталог = РаботаСФайламиКлиент.СоздатьИлиНайтиКаталог(ПутьКПапкеТХПоПряже);	 
		Если Каталог=неопределено тогда
			Возврат;
		Конецесли;
		Файл=ДиалогОткрытияФайла.ПолноеИмяФайла ;
		ТекущиеДанные.ПутьКФайлу = ".\" + Прав(Файл, СтрДлина(Файл) - СтрДлина(Каталог));
		ТекущиеДанные.КлючСтроки = СтрокаТекущиеДанные.КлючСтроки;
		РазместитьФайлВПолеHTML(ТекущиеДанные)
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТехХарактеристикиПутьКФайлуПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТехХарактеристики.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не Элементы.ТехХарактеристикиПредварительныйПросмотр.Пометка Тогда		
		Возврат;
	КонецЕсли;
	РазместитьФайлВПолеHTML(ТекущиеДанные);
КонецПроцедуры

