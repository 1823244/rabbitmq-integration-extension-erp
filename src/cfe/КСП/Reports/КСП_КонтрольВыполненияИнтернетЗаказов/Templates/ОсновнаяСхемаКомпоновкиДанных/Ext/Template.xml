		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ЗаказКлиентаТовары.Ссылка.Дата КАК Дата,
	Склады.Ссылка КАК ИсточникИнтернетЗаказа,
	ЗаказКлиентаТовары.Ссылка.НомерПоДаннымКлиента КАК НомерПоДаннымКлиента,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "podtverzhden"
			ТОГДА "Заказ принят"
		КОГДА КСП_ИсторияЗаказов.Статус = "obrabotka"
			ТОГДА "В работе"
		КОГДА КСП_ИсторияЗаказов.Статус = "gotov-k-otpravke"
			ТОГДА "Готов к отправке"
		КОГДА КСП_ИсторияЗаказов.Статус = "otgruzhen"
			ТОГДА "Передан в службу доставки"
		КОГДА КСП_ИсторияЗаказов.Статус = "dostavlen-v-magazin"
			ТОГДА "Доставлен в магазин"
		КОГДА КСП_ИсторияЗаказов.Статус = "send-to-delivery"
			ТОГДА "Доставлен в пункт выдачи"
		КОГДА КСП_ИсторияЗаказов.Статус = "complete"
			ТОГДА "Доставлен получателю"
		КОГДА КСП_ИсторияЗаказов.Статус = "cancel"
			ТОГДА "Отменен"
		КОГДА КСП_ИсторияЗаказов.Статус = "ozhidaet-oplaty"
			ТОГДА "Согласование изменений"
		КОГДА КСП_ИсторияЗаказов.Статус = "new"
			ТОГДА "Формируется"
	КОНЕЦ КАК Статус,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "new"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК Формируется,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "podtverzhden"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ЗаказПринят,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "obrabotka"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ВРаботе,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "gotov-k-otpravke"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ГотовКотправке,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "dostavlen-v-magazin"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ДоставленВМагазин,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "send-to-delivery"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ДоставленВпунктВыдачи,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "complete"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ДоставленПолучателю,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "ozhidaet-oplaty"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК СогласованиеИзм,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "cancel"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК Отменен,
	ВЫБОР
		КОГДА КСП_ИсторияЗаказов.Статус = "otgruzhen"
			ТОГДА КСП_ИсторияЗаказов.Период
	КОНЕЦ КАК ПереданВСлужбуДоставки,
	ЗаказыКлиентов.ЗаказКлиента КАК Заказ
ИЗ
	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
		ПО ЗаказыКлиентов.Склад = Склады.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КСП_ИсторияЗаказов КАК КСП_ИсторияЗаказов
		ПО ЗаказыКлиентов.ЗаказКлиента = КСП_ИсторияЗаказов.ЗаказКлиента
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ПО ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка
			И ЗаказыКлиентов.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка
ГДЕ
	Склады.ДополнительныеРеквизиты.Значение = ИСТИНА
	И ЗаказКлиентаТовары.Ссылка.Дата &lt;&gt; ""</query>
