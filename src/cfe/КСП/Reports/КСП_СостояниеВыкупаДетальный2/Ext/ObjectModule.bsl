				|		ПО (ПочтиФин.Ссылка = Запасы.ЗаказКлиента)
				|			И (ПочтиФин.ДатаПоступления = Запасы.Период)";
	
	Запрос.УстановитьПараметр("СкладОТП2", СкладОТП);
	Запрос.УстановитьПараметр("Клиент2", Организация);
