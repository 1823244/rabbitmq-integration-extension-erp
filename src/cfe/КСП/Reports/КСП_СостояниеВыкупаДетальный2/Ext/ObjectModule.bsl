
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	//НастройкиКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;  
    НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	Для Каждого эл Из КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(эл) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Переменная = 1;
		Иначе
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("Период") Тогда
				ДатаНачала = эл.Значение.ДатаНачала;
				ДатаОкончания = эл.Значение.ДатаОкончания;
			КонецЕсли;
			
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("СкладОТП") Тогда
				СкладОТП = эл.Значение;	
			КонецЕсли;
			
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("Клиент") Тогда
				Организация = эл.Значение;
			КонецЕсли;
	     КонецЕсли;
		
	КонецЦикла;   
	
	ТаблицаИсточник = ПолучениеТаблици(ДатаНачала, ДатаОкончания, СкладОТП, Организация);
	
	//Таблица = ТаблицаИсточник;
	
	//ТаблицаИсточник = МассивИсточник[14].Выгрузить();
	//Таблица.Свернуть("Договор,ВидДоговора,Магазин,ВидМагазина,ВариантЦены,ПризнакЗакрытияЗаказа", "ЗаказЗаказано_Сумма,ОтгрузкаОтгружено_Шт,ДолжнаБытьСуммаПредоплаты,НаличиеДСКлиента,СвободныеДСКлиента,ОтгруженоПоЗаявкеВЦенахЗаявки");
	
	ВнешнийНаборДанных = Новый Структура("ТаблицаДанных", ТаблицаИсточник);
	
	// НастройкиКомпоновки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("Период"));
		
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки);
     
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных);
     
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);	
	
КонецПроцедуры

Функция ПолучениеТаблици(ДатаНачала, ДатаКонца, СкладОТП, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
				|	ЗаказКлиентаТовары.Отменено КАК Отменено
				|ПОМЕСТИТЬ ЗакрытПоТЧСтрока
				|ИЗ
				|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
				|ГДЕ
				|	ЗаказКлиентаТовары.НомерСтроки = 1
				|	И ЗаказКлиентаТовары.Ссылка.Партнер = &Клиент2
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказКлиентаТовары.Отменено,
				|	ЗаказКлиентаТовары.Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЗаказыКлиентов.ЗаказКлиента КАК Заказ,
				|	ВЫБОР
				|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Отменено) = 1
				|			ТОГДА ЗакрытПоТЧСтрока.Отменено
				|		ИНАЧЕ ЛОЖЬ
				|	КОНЕЦ КАК Отменено,
				|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Отменено) КАК НомерСтроки,
				|	ЗаказыКлиентов.Регистратор КАК Регистратор,
				|	СУММА(ВЫБОР
				|			КОГДА ЗаказКлиентаТовары.Отменено = ИСТИНА
				|				ТОГДА 0
				|			ИНАЧЕ ЗаказКлиентаТовары.Сумма
				|		КОНЕЦ) КАК СуммаОтменено,
				|	ЗаказКлиентаТовары.Ссылка КАК Ссылка
				|ПОМЕСТИТЬ закрытПоТЧ
				|ИЗ
				|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
				|			ЛЕВОЕ СОЕДИНЕНИЕ ЗакрытПоТЧСтрока КАК ЗакрытПоТЧСтрока
				|			ПО (ЗаказКлиентаТовары.Ссылка = ЗакрытПоТЧСтрока.Ссылка)
				|		ПО (ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка)
				|ГДЕ
				|	ЗаказКлиентаТовары.Ссылка.Партнер = &Клиент2
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказКлиентаТовары.Ссылка,
				|	ЗаказыКлиентов.ЗаказКлиента,
				|	ЗакрытПоТЧСтрока.Отменено,
				|	ЗаказыКлиентов.Регистратор
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЗаказыКлиентов.ЗаказКлиента КАК Заказ,
				|	ВЫБОР
				|		КОГДА закрытПоТЧ.Отменено = ИСТИНА
				|			ТОГДА ИСТИНА
				|		ИНАЧЕ ВЫБОР
				|				КОГДА ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
				|						И РеализацияТоваровУслуг.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
				|					ТОГДА ИСТИНА
				|				ИНАЧЕ ЛОЖЬ
				|			КОНЕЦ
				|	КОНЕЦ КАК ПризнакЗакрытияЗаказа,
				|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
				|	РеализацияТоваровУслуг.Номер КАК Номер
				|ПОМЕСТИТЬ закрыт
				|ИЗ
				|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
				|		ПО (ЗаказыКлиентов.Регистратор = ПоступлениеБезналичныхДенежныхСредств.ДокументОснование)
				|			И (ЗаказыКлиентов.ЗаказКлиента = ПоступлениеБезналичныхДенежныхСредств.ДокументОснование)
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
				|		ПО (ЗаказыКлиентов.Регистратор = РеализацияТоваровУслуг.ЗаказКлиента)
				|			И (ЗаказыКлиентов.ЗаказКлиента = РеализацияТоваровУслуг.ЗаказКлиента)
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
				|		ПО (ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка)
				|			И (ЗаказыКлиентов.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка)
				|		ЛЕВОЕ СОЕДИНЕНИЕ закрытПоТЧ КАК закрытПоТЧ
				|		ПО (ЗаказыКлиентов.Регистратор = закрытПоТЧ.Заказ)
				|			И (ЗаказыКлиентов.ЗаказКлиента = закрытПоТЧ.Заказ)
				|ГДЕ
				|	ЗаказКлиентаТовары.Ссылка.Партнер = &Клиент2
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказыКлиентов.ЗаказКлиента,
				|	ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента,
				|	ЗаказыКлиентов.Сумма,
				|	ВЫБОР
				|		КОГДА закрытПоТЧ.Отменено = ИСТИНА
				|			ТОГДА ИСТИНА
				|		ИНАЧЕ ВЫБОР
				|				КОГДА ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
				|						И РеализацияТоваровУслуг.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
				|					ТОГДА ИСТИНА
				|				ИНАЧЕ ЛОЖЬ
				|			КОНЕЦ
				|	КОНЕЦ,
				|	РеализацияТоваровУслуг.Ссылка,
				|	РеализацияТоваровУслуг.Номер
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	СУММА(ЗаказыКлиентов.Сумма) КАК СуммаЗаявкиСУчётомКорректировки,
				|	СУММА(ЗаказыКлиентов.КОформлению / ВЫБОР
				|			КОГДА ЗаказыКлиентов.Заказано = 0
				|				ТОГДА 1
				|			ИНАЧЕ ЗаказыКлиентов.Заказано
				|		КОНЕЦ * 100) КАК ОтгруженоПоЗаявкеВЦенахЗаявки,
				|	СУММА(ЗаказыКлиентов.Сумма / 10) КАК ДолжнаБытьСуммаПредоплаты,
				|	СУММА(ЗаказыКлиентов.Заказано) КАК ЗаказЗаказано_Шт,
				|	СУММА(ЗаказыКлиентов.Сумма) КАК ЗаказЗаказано_Сумма,
				|	МАКСИМУМ(ЗаказыКлиентовОбороты.КОформлениюРасход) КАК ОтгрузкаОтгружено_Шт,
				|	СУММА(ЗаказыКлиентовОбороты.КОформлениюРасход) КАК ОтгрузкаОтгруженоСуммаВЦенахЗаявки,
				|	СУММА(ЗаказыКлиентов.КОформлению / ВЫБОР
				|			КОГДА ЗаказыКлиентов.Заказано = 0
				|				ТОГДА 1
				|			ИНАЧЕ ЗаказыКлиентов.Заказано
				|		КОНЕЦ * 100) КАК ОтгрузкаПроцентВыкупаВШт,
				|	СРЕДНЕЕ(ЗаказыКлиентовОбороты.КОформлениюПриход) КАК РезервРезервШт,
				|	СУММА(ЗаказыКлиентовОбороты.КОформлениюПриход * (ЗаказыКлиентов.Сумма / ВЫБОР
				|			КОГДА ЗаказыКлиентов.Заказано = 0
				|				ТОГДА 1
				|			ИНАЧЕ ЗаказыКлиентов.Заказано
				|		КОНЕЦ)) КАК РезервРезервСумма,
				|	ЗаказыКлиентов.Номенклатура КАК Номенклатура,
				|	ЗаказыКлиентов.Характеристика КАК Характеристика,
				|	ЗаказыКлиентов.Склад КАК Склад,
				|	ЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
				|	ЗаказыКлиентов.ЗаказКлиента.Номер КАК ЗаказКлиентаНомер,
				|	СУММА(ЗаказыКлиентовОбороты.КОформлениюРасход) КАК КОформлениюРасход,
				|	МИНИМУМ(ЗаказыКлиентовОбороты.КОформлениюПриход + ЗаказыКлиентов.КОформлению) КАК ОтгрузкаИРезервШт,
				|	ЗаказыКлиентов.ЗаказКлиента.КСП_Коллекция.ДатаНачалаПродаж КАК ЗаказКлиентаКСП_КоллекцияДатаНачалаПродаж,
				|	ЗаказыКлиентов.ЗаказКлиента.КСП_Коллекция.ДатаЗапретаПродажи КАК ЗаказКлиентаКСП_КоллекцияДатаЗапретаПродажи,
				|	ЗаказыКлиентов.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески КАК ПериодВывески
				|ПОМЕСТИТЬ РНЗаказы
				|ИЗ
				|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыКлиентов.Обороты КАК ЗаказыКлиентовОбороты
				|		ПО (ЗаказыКлиентов.ЗаказКлиента = ЗаказыКлиентовОбороты.ЗаказКлиента)
				|			И (ЗаказыКлиентов.Номенклатура = ЗаказыКлиентовОбороты.Номенклатура)
				|			И (ЗаказыКлиентов.Характеристика = ЗаказыКлиентовОбороты.Характеристика)
				|			И (ЗаказыКлиентов.Склад = ЗаказыКлиентовОбороты.Склад)
				|			И (ЗаказыКлиентов.КодСтроки = ЗаказыКлиентовОбороты.КодСтроки)
				|			И (ЗаказыКлиентов.Серия = ЗаказыКлиентовОбороты.Серия)
				|ГДЕ
				|	ЗаказыКлиентов.Период МЕЖДУ &НачалоПериода2 И &КонецПериода2
				|	И ЗаказыКлиентов.Регистратор = ЗаказыКлиентов.ЗаказКлиента
				|	И ЗаказыКлиентов.ЗаказКлиента.Партнер = &Клиент2
				|	И ЗаказыКлиентов.Номенклатура <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказыКлиентов.Номенклатура,
				|	ЗаказыКлиентов.Характеристика,
				|	ЗаказыКлиентов.Склад,
				|	ЗаказыКлиентов.ЗаказКлиента,
				|	ЗаказыКлиентов.ЗаказКлиента.Номер,
				|	ЗаказыКлиентов.ЗаказКлиента.КСП_Коллекция.ДатаНачалаПродаж,
				|	ЗаказыКлиентов.ЗаказКлиента.КСП_Коллекция.ДатаЗапретаПродажи,
				|	ЗаказыКлиентов.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЗаказыКлиентов.Номенклатура КАК Номенклатура,
				|	ЗаказыКлиентов.Характеристика КАК Характеристика,
				|	ЗаказыКлиентов.Склад КАК Склад,
				|	ЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
				|	ЗаказыКлиентов.КодСтроки КАК КодСтроки,
				|	ЗаказыКлиентов.Период КАК Период,
				|	ЗаказыКлиентов.КОформлению КАК КОформлению,
				|	ЗаказыКлиентов.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески КАК НоменклатураКСП_АртикулУППКапсулаПериодВывески
				|ПОМЕСТИТЬ РезервыПоДатам
				|ИЗ
				|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
				|ГДЕ
				|	ЗаказыКлиентов.Период МЕЖДУ &НачалоПериода2 И &КонецПериода2
				|	И ЗаказыКлиентов.Регистратор = ЗаказыКлиентов.ЗаказКлиента
				|	И ЗаказыКлиентов.ЗаказКлиента.Партнер = &Клиент2
				|	И ЗаказыКлиентов.Заказано = 0
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
				|	ЗаказыКлиентов.Период КАК Период,
				|	СУММА(ЗаказыКлиентов.КОформлению) КАК КОформлению
				|ПОМЕСТИТЬ Запасы
				|ИЗ
				|	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
				|ГДЕ
				|	ЗаказыКлиентов.Период МЕЖДУ &НачалоПериода2 И &КонецПериода2
				|	И ЗаказыКлиентов.ЗаказКлиента.Партнер = &Клиент2
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказыКлиентов.ЗаказКлиента,
				|	ЗаказыКлиентов.Период
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
				|	РаспределениеЗапасов.Характеристика КАК Характеристика,
				|	СУММА(РаспределениеЗапасов.Свободно) КАК Свободно,
				|	СУММА(РаспределениеЗапасов.Резерв) КАК Резерв,
				|	РаспределениеЗапасов.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески КАК НоменклатураКСП_АртикулУППКапсулаПериодВывески
				|ПОМЕСТИТЬ ЗапасыОБ
				|ИЗ
				|	РНЗаказы КАК РНЗаказы
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
				|		ПО (РНЗаказы.Номенклатура = РаспределениеЗапасов.Номенклатура)
				|			И (РНЗаказы.Характеристика = РаспределениеЗапасов.Характеристика)
				|
				|СГРУППИРОВАТЬ ПО
