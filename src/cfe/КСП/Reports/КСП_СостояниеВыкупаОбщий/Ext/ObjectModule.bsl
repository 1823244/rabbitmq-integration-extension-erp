
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	//НастройкиКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;  
    НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	Для Каждого эл Из КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(эл) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
		Иначе
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("Период") Тогда
				ДатаНачала = эл.Значение.ДатаНачала;
				ДатаОкончания = эл.Значение.ДатаОкончания;
			КонецЕсли;
			
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("СкладОТП") Тогда
				СкладОТП = эл.Значение;	
			КонецЕсли;
			
			Если эл.Параметр = Новый ПараметрКомпоновкиДанных("Организация") Тогда
				Организация = эл.Значение;
			КонецЕсли;
	    КонецЕсли;
		
	КонецЦикла;   
	
	ТаблицаИсточник = ПолучениеТаблици(ДатаНачала, ДатаОкончания, СкладОТП, Организация);
	
	 ВнешнийНаборДанных = Новый Структура("ТаблицаДанных", ТаблицаИсточник);
	// НастройкиКомпоновки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("Период"));
		
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки);
     
    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных);
     
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);	
	
КонецПроцедуры

Функция ПолучениеТаблици(ДатаНачала, ДатаКонца, СкладОТП, Организация)
	
		Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	               |	ЗаказКлиентаТовары.Отменено КАК Отменено
	               |ПОМЕСТИТЬ ЗакрытПоТЧСтрока
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.НомерСтроки = 1
	               |	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Отменено,
	               |	ЗаказКлиентаТовары.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказыКлиентов.ЗаказКлиента КАК Заказ,
	               |	ВЫБОР
	               |		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Отменено) = 1
	               |			ТОГДА ЗакрытПоТЧСтрока.Отменено
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Отменено,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Отменено) КАК НомерСтроки,
	               |	ЗаказыКлиентов.Регистратор КАК Регистратор,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказКлиентаТовары.Отменено = ИСТИНА
	               |				ТОГДА 0
	               |			ИНАЧЕ ЗаказКлиентаТовары.Сумма
	               |		КОНЕЦ) КАК СуммаОтменено
	               |ПОМЕСТИТЬ закрытПоТЧ
	               |ИЗ
	               |	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ЗакрытПоТЧСтрока КАК ЗакрытПоТЧСтрока
	               |			ПО ЗаказКлиентаТовары.Ссылка = ЗакрытПоТЧСтрока.Ссылка
	               |		ПО ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыКлиентов.ЗаказКлиента,
	               |	ЗакрытПоТЧСтрока.Отменено,
	               |	ЗаказыКлиентов.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказыКлиентов.ЗаказКлиента КАК Заказ,
	               |	ВЫБОР
	               |		КОГДА закрытПоТЧ.Отменено = ИСТИНА
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
	               |						И РеализацияТоваровУслуг.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ПризнакЗакрытияЗаказа,
	               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ закрыт
	               |ИЗ
	               |	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
	               |		ПО ЗаказыКлиентов.Регистратор = ПоступлениеБезналичныхДенежныхСредств.ДокументОснование
	               |			И ЗаказыКлиентов.ЗаказКлиента = ПоступлениеБезналичныхДенежныхСредств.ДокументОснование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |		ПО ЗаказыКлиентов.Регистратор = РеализацияТоваровУслуг.ЗаказКлиента
	               |			И ЗаказыКлиентов.ЗаказКлиента = РеализацияТоваровУслуг.ЗаказКлиента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ПО ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка
	               |			И ЗаказыКлиентов.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ закрытПоТЧ КАК закрытПоТЧ
	               |		ПО ЗаказыКлиентов.Регистратор = закрытПоТЧ.Заказ
	               |			И ЗаказыКлиентов.ЗаказКлиента = закрытПоТЧ.Заказ
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыКлиентов.ЗаказКлиента,
	               |	ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента,
	               |	ЗаказыКлиентов.Сумма,
	               |	ВЫБОР
	               |		КОГДА закрытПоТЧ.Отменено = ИСТИНА
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ПоступлениеБезналичныхДенежныхСредств.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
	               |						И РеализацияТоваровУслуг.СуммаДокумента = ЗаказКлиентаТовары.Ссылка.СуммаДокумента - закрытПоТЧ.СуммаОтменено
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	РеализацияТоваровУслуг.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
	               |	РаспределениеЗапасов.Характеристика КАК Характеристика,
	               |	СУММА(РаспределениеЗапасов.Свободно) КАК Свободно,
	               |	СУММА(РаспределениеЗапасов.Резерв) КАК Резерв
	               |ПОМЕСТИТЬ Запасы
	               |ИЗ
	               |	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РаспределениеЗапасов.Номенклатура,
	               |	РаспределениеЗапасов.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	СТРОКА(ЗаказКлиентаТовары.Номенклатура.КоллекцияНоменклатуры.ДатаНачалаПродаж) + "", "" + СТРОКА(ЗаказКлиентаТовары.Номенклатура.КоллекцияНоменклатуры.ДатаЗапретаПродажи) КАК ПериодВывески,
	               |	СУММА(ЗаказКлиентаТовары.Сумма) КАК Сумма,
	               |	ЗаказКлиентаТовары.Ссылка.Ссылка КАК Ссылка,
	               |	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	               |	ЗаказКлиентаТовары.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески КАК ПериодВывески1
	               |ПОМЕСТИТЬ ТЧДокЗаказы
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка.Проведен = ИСТИНА
	               |	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Ссылка.Ссылка,
	               |	СТРОКА(ЗаказКлиентаТовары.Номенклатура.КоллекцияНоменклатуры.ДатаНачалаПродаж) + "", "" + СТРОКА(ЗаказКлиентаТовары.Номенклатура.КоллекцияНоменклатуры.ДатаЗапретаПродажи),
	               |	ЗаказКлиентаТовары.Номенклатура.КСП_АртикулУПП.Капсула.ПериодВывески
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РаспределениеЗапасов.Номенклатура КАК Номенклатура1,
	               |	РаспределениеЗапасов.Характеристика КАК Характеристика1,
	               |	СУММА(РаспределениеЗапасов.Свободно) КАК КоличествоСвободныйОстатокНаСкладеОТПДляЗакрытияПотребности
	               |ПОМЕСТИТЬ ЗапасыИПотребности
	               |ИЗ
	               |	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
	               |ГДЕ
	               |	РаспределениеЗапасов.Склад = &СкладОТП
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РаспределениеЗапасов.Номенклатура,
	               |	РаспределениеЗапасов.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЗаказКлиентаТовары.Ссылка.Соглашение КАК Соглашение,
	               |	ЗаказКлиентаТовары.Ссылка.Склад КАК Склад,
	               |	ЗаказКлиентаТовары.Ссылка.Соглашение.ИндивидуальныйВидЦены КАК СоглашениеВидЦен,
	               |	ЗаказКлиентаТовары.Ссылка.Склад.Родитель КАК СкладРодитель,
	               |	СУММА(ЗаказыКлиентов.Заказано) КАК Заказано,
	               |	СУММА(ЗаказыКлиентов.Сумма) КАК СуммаЗаказСУчетомКорректировок,
	               |	СУММА((ЗаказыКлиентов.Заказано - ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход) * (ЗаказыКлиентов.Сумма / ВЫБОР
	               |			КОГДА ЗаказыКлиентов.Заказано = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ ЗаказыКлиентов.Заказано
	               |		КОНЕЦ)) КАК ОстатокЗаказаВЦенахЗаявки,
	               |	МАКСИМУМ(ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход) КАК КоличествоОтгружено,
	               |	СУММА(ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход * (ЗаказыКлиентов.Сумма / ВЫБОР
	               |			КОГДА ЗаказыКлиентов.Заказано = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ ЗаказыКлиентов.Заказано
	               |		КОНЕЦ)) КАК СуммаОтгруженоВЦенахЗаявки,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказыКлиентов.Заказано - ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход < 0
	               |				ТОГДА 0
	               |			ИНАЧЕ ЗаказыКлиентов.Заказано - ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход
	               |		КОНЕЦ) КАК КоличествоОсталосьОтгрузить,
	               |	СРЕДНЕЕ(ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход / ВЫБОР
	               |			КОГДА ЗаказыКлиентов.Заказано = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ ЗаказыКлиентов.Заказано
	               |		КОНЕЦ * 100) КАК ПроцентВыкупа,
	               |	МАКСИМУМ(ЗаказыКлиентовОстаткиИОбороты.КОформлениюПриход) КАК КоличествоРезерв,
	               |	МИНИМУМ(ЗаказыКлиентовОстаткиИОбороты.КОформлениюПриход + ЗаказыКлиентов.КОформлению) КАК ОтгрузкаИРезервШт,
	               |	МИНИМУМ(ЗаказыКлиентовОстаткиИОбороты.КОформлениюПриход + ЗаказыКлиентов.КОформлению) КАК ПроцентОтгрузкаРезервОтЗаказа,
	               |	ЗаказКлиентаТовары.Ссылка.Подразделение КАК ОТП,
	               |	ЗаказКлиентаТовары.Ссылка.Партнер КАК Контрагент,
	               |	ЗаказКлиентаТовары.Ссылка.Партнер.БизнесРегион КАК Субрегион,
	               |	ЗаказыКлиентов.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	               |	ЗаказыКлиентов.КодСтроки КАК КодСтроки,
	               |	ЗаказыКлиентов.Характеристика КАК Характеристика,
	               |	СУММА(ЗаказыКлиентовОстаткиИОбороты.КОформлениюРасход) КАК КОформлениюРасход
	               |ПОМЕСТИТЬ РНЗаказы
	               |ИЗ
	               |	РегистрНакопления.ЗаказыКлиентов КАК ЗаказыКлиентов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ПО ЗаказыКлиентов.Регистратор = ЗаказКлиентаТовары.Ссылка
	               |			И ЗаказыКлиентов.Номенклатура = ЗаказКлиентаТовары.Номенклатура
	               |			И ЗаказыКлиентов.Характеристика = ЗаказКлиентаТовары.Характеристика
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыКлиентов.ОстаткиИОбороты КАК ЗаказыКлиентовОстаткиИОбороты
	               |		ПО ЗаказыКлиентов.Регистратор = ЗаказыКлиентовОстаткиИОбороты.ЗаказКлиента
	               |			И ЗаказыКлиентов.Номенклатура = ЗаказыКлиентовОстаткиИОбороты.Номенклатура
	               |			И ЗаказыКлиентов.Характеристика = ЗаказыКлиентовОстаткиИОбороты.Характеристика
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка <> """"
	               |	И ЗаказыКлиентов.Заказано > 0
	               |	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Ссылка,
	               |	ЗаказКлиентаТовары.Ссылка.Склад,
	               |	ЗаказКлиентаТовары.Ссылка.Партнер,
	               |	ЗаказКлиентаТовары.Ссылка.Соглашение,
	               |	ЗаказКлиентаТовары.Ссылка.Подразделение,
	               |	ЗаказКлиентаТовары.Ссылка.Склад.Родитель,
	               |	ЗаказКлиентаТовары.Ссылка.Партнер.БизнесРегион,
	               |	ЗаказыКлиентов.Регистратор,
	               |	ЗаказыКлиентов.Номенклатура,
	               |	ЗаказКлиентаТовары.Ссылка.Соглашение.ИндивидуальныйВидЦены,
	               |	ЗаказыКлиентов.КодСтроки,
	               |	ЗаказыКлиентов.Характеристика
	               |;
	               |
