		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПланПродаж</dataPath>
			<field>ПланПродаж</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>План продаж</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПланыПродаж.Номенклатура КАК Номенклатура,
	ПланыПродаж.Характеристика КАК Характеристика,
	ПланыПродаж.Количество КАК План,
	ПланыПродаж.КЗаказу КАК ОсталосьОбеспечить,
	ПланыПродаж.Количество - ПланыПродаж.КЗаказу КАК Обеспечено,
	ПланыПродаж.Регистратор КАК ПланПродаж
ИЗ
	РегистрНакопления.ПланыПродаж КАК ПланыПродаж
ГДЕ
	ПланыПродаж.Сценарий = &amp;СценарийПолный
	ИЛИ ПланыПродаж.Сценарий = &amp;СценарийТекущий
	И ПланыПродаж.Статус = &amp;Статус
	И ПланыПродаж.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
	<totalField>
		<dataPath>План</dataPath>
		<expression>Сумма(План)</expression>
	</totalField>
	<totalField>
		<dataPath>ОсталосьОбеспечить</dataPath>
