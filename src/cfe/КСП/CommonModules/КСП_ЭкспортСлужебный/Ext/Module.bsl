Процедура ДополнитьОбъектИнформацией(СтруктураОбъекта, Ссылка)
	
	Если СтруктураОбъекта.type = "Документ.ЗаказКлиента" Тогда 
		
		ДополнитьЗаказКлиентаИнформацией(СтруктураОбъекта, Ссылка);
		
	ИначеЕсли СтруктураОбъекта.type = "Документ.РасходныйОрдерНаТовары" Тогда 
		
		ДополнитьРасходныйОрдерИнформацией(СтруктураОбъекта, Ссылка);
		
	ИначеЕсли СтруктураОбъекта.type = "Справочник.Номенклатура" Тогда
		
		 ДополнитьНоменклатуруИнформацией(СтруктураОбъекта, Ссылка);
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ДополнитьНоменклатуруИнформацией(СтруктураОбъекта, Ссылка)
	
	ДополнительныеДанные = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.КСП_АртикулУПП.Капсула КАК Капсула,
		|	Номенклатура.КСП_АртикулУПП.Цвет КАК Цвет,
		|	Номенклатура.КоллекцияНоменклатуры КАК Коллекция,
		|	Номенклатура.КоллекцияНоменклатуры.Родитель.Родитель КАК Сезон
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДополнительныеДанные.Вставить("Капсула", Строка(РезультатЗапроса.Капсула));
		ДополнительныеДанные.Вставить("Цвет", Строка(РезультатЗапроса.Цвет));
		ДополнительныеДанные.Вставить("Коллекция", Строка(РезультатЗапроса.Коллекция));
		ДополнительныеДанные.Вставить("Сезон", Строка(РезультатЗапроса.Сезон));
		Прервать;
		
	КонецЦикла;
		
	СформироватьДополнительныеДанныеДляRabbit(СтруктураОбъекта, ДополнительныеДанные);
	
	
КонецПроцедуры

Процедура ДополнитьРасходныйОрдерИнформацией(СтруктураОбъекта, Ссылка) 
	
	Если НЕ СтруктураОбъекта.definition.ТЧТоварыПоРаспоряжениям.Количество() Тогда 
		
		Возврат;
		
	КонецЕСли;
	
	Если Не СтруктураОбъекта.definition.ТЧТоварыПоРаспоряжениям[0].Распоряжение.Свойство("type") Тогда  
		
		Возврат;
		
	ИначеЕсли НЕ СтруктураОбъекта.definition.ТЧТоварыПоРаспоряжениям[0].Распоряжение.type = "Документ.РеализацияТоваровУслуг" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеДанные = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
		|	РеализацияТоваровУслугТовары.Сумма КАК Сумма,
		|	РеализацияТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
		|	РеализацияТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
		|	РеализацияТоваровУслугТовары.СуммаСНДС КАК СуммаСНДС,
		|	РеализацияТоваровУслугТовары.Цена КАК Цена
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка.ТоварыПоРаспоряжениям[0].Распоряжение);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
    ТаблицаЦен= ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса);
	
	ДополнительныеДанные.Вставить("ТЧЦеныДокумента", ТаблицаЦен);
	
	СформироватьДополнительныеДанныеДляRabbit(СтруктураОбъекта, ДополнительныеДанные);

КонецПроцедуры 

Процедура ДополнитьЗаказКлиентаИнформацией(СтруктураОбъекта, Ссылка)
	
    	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	СтруктураОбъекта.definition.Вставить("НомерИнтернетЗаказа","");
	СтруктураОбъекта.definition.Вставить("СтатусИнтернетЗаказа","");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ксп_ИсходныеДанныеЗаказов.id КАК id,
		|	ксп_ИсходныеДанныеЗаказов.status КАК status
		|ИЗ
		|	РегистрСведений.КСП_ИсходныеДанныеЗаказов КАК ксп_ИсходныеДанныеЗаказов
		|ГДЕ
		|	ксп_ИсходныеДанныеЗаказов.ЗаказКлиента = &ЗаказКлиента";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураОбъекта.definition.НомерИнтернетЗаказа = ВыборкаДетальныеЗаписи.id; 
		СтруктураОбъекта.definition.СтатусИнтернетЗаказа = ВыборкаДетальныеЗаписи.status;

		Возврат;
		
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

	
КонецПроцедуры


Процедура СформироватьДополнительныеДанныеДляRabbit(СтруктураОбъекта, ДополнительныеДанные)
	
	Для каждого Данные Из ДополнительныеДанные Цикл
		
		Если ТипЗнч(Данные.Значение) = Тип("Массив") Тогда
			
			Для каждого Элемент Из Данные.Значение Цикл
				
				Для каждого Строка Из Элемент Цикл
					
					Если ТипЗнч(Строка.Значение) = Тип("Булево") 
						ИЛИ ТипЗнч(Строка.Значение) = Тип("Строка") 
						ИЛИ ТипЗнч(Строка.Значение) = Тип("Число")
						ИЛИ ТипЗнч(Строка.Значение) = Тип("Дата") 
						ИЛИ ТипЗнч(Строка.Значение) = Тип("Неопределено") Тогда
						
						Элемент.Вставить(Строка.Ключ, Строка.Значение);
						
					Иначе
						
						Элемент.Вставить(Строка.Ключ, СоздатьУзелIdentification(Строка.Значение));
						
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЦикла;
			
		Иначе
			
			Если ТипЗнч(Данные.Значение) = Тип("Булево") 
				ИЛИ ТипЗнч(Данные.Значение) = Тип("Строка") 
				ИЛИ ТипЗнч(Данные.Значение) = Тип("Число")
				ИЛИ ТипЗнч(Данные.Значение) = Тип("Дата") 
				ИЛИ ТипЗнч(Данные.Значение) = Тип("Неопределено") Тогда
				
				ДополнительныеДанные.Вставить(Данные.Ключ, Данные.Значение);
				
			Иначе
				
				ДополнительныеДанные.Вставить(Данные.Ключ, СоздатьУзелIdentification(Данные.Значение));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(СтруктураОбъекта.definition, ДополнительныеДанные, Истина);
	
КонецПроцедуры


