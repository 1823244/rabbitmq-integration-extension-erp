

&НаСервере
Функция ПолучитьСодержаниеЯчейки(пТабличныйДокумент, Строка, Колонка) Экспорт	
	Если Колонка = 0 Тогда
		Возврат "";
	КонецЕсли;	
	мСодержание = пТабличныйДокумент.Область("R" + Формат(Строка,"ЧГ=") + "C" + Формат(Колонка,"ЧГ=")).Текст;	
	Возврат СокрЛП(мСодержание);
КонецФункции

&НаСервере
Процедура ЗагрузкаЗаказа(ДвоичДанные, Расширение, ПолноеИмя) Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичДанные.Записать(ИмяФайла);
	
	Заказ = Документы.ЗаказКлиента.СоздатьДокумент();
	Заказ.Дата = ТекущаяДата();
	Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;
	Заказ.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Очистить();
    ТабличныйДокумент.Прочитать(ИмяФайла);
	
	КоличествоСтраниц = 1;
	
	Для НомерЛиста = 1 По КоличествоСтраниц Цикл 
		КоличествоСтрок = ТабличныйДокумент.Области.Найти("Итоговый_лист").Низ;
		Если ЗначениеЗаполнено(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, 6, 7)) Тогда
			Заказ.КСП_Коллекция = Справочники.КоллекцииНоменклатуры.НайтиПоНаименованию(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, 6, 7));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, 4, 7)) Тогда
			Заказ.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, 4, 7));
		КонецЕсли;

        МассивРазмеров = Новый Массив;
		Для НомерКолонки = 11 По 19 Цикл
			МассивРазмеров.Добавить(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, 10, НомерКолонки));
		КонецЦикла;
		Для НомерСтроки = 13 По КоличествоСтрок Цикл
			Если ЗначениеЗаполнено(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, 4)) Тогда
				Для НомерКолонки = 11 По 19 Цикл
					Если ЗначениеЗаполнено(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)) Тогда 
						Нстр = Заказ.Товары.Добавить();
						НаименованиеТовара = ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, 4);
						Модель = ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, 5);
						Цвет = ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, 7);
		
						Запрос = Новый Запрос;
						Запрос.Текст = 
							"ВЫБРАТЬ
							|	Номенклатура.Ссылка КАК Ссылка,
							|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка1,
							|	Номенклатура.Наименование КАК Наименование
							|ИЗ
							|	Справочник.Номенклатура КАК Номенклатура
							|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
							|		ПО Номенклатура.Ссылка = ХарактеристикиНоменклатуры.Владелец
							|ГДЕ
							|	Номенклатура.Наименование ПОДОБНО ""%"" + &Модель + ""%""";
						Запрос.УстановитьПараметр("Модель", Модель);
						Запрос.УстановитьПараметр("Размер", МассивРазмеров[НомерКолонки - 11]);
						
						РезультатЗапроса = Запрос.Выполнить();
						
						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
						
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							Если СтрНайти(ВыборкаДетальныеЗаписи.Наименование, Цвет) Тогда
								Нстр.Номенклатура = ВыборкаДетальныеЗаписи.Ссылка;
								поискХарактеристики = "-" + СокрЛП(МассивРазмеров[НомерКолонки - 11] + "-");
								Если СтрНайти(ВыборкаДетальныеЗаписи.Ссылка1, поискХарактеристики) > 0 Тогда
									Нстр.Характеристика = ВыборкаДетальныеЗаписи.Ссылка1;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;

	//					Если ЗначениеЗаполнено(ТекТовар) Тогда
	//						Нстр.Номенклатура	= ТекТовар;
	//						Нстр.Характеристика = текХарактеристика;
	//
	//						Запрос = Новый Запрос;
	//						Запрос.Текст = 
	//							"ВЫБРАТЬ
	//							|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	//							|ИЗ
	//							|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	//							|ГДЕ
	//							|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура";
	//						
	//						Запрос.УстановитьПараметр("Номенклатура", ТекТовар);
	//						
	//						РезультатЗапроса = Запрос.Выполнить();
	//						
	//						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	//						
	//						Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	//							Нстр.КСП_БазоваяЦена = ВыборкаДетальныеЗаписи.Цена;
	//						КонецЕсли;
	//
	//					КонецЕсли;
						Нстр.КоличествоУпаковок	= Число(ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки));
						Нстр.Цена = ПолучитьСодержаниеЯчейки(ТабличныйДокумент, НомерСтроки, 21);
						Нстр.Сумма = Нстр.КоличествоУпаковок * Нстр.Цена;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	 
	
	Попытка
		Заказ.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		НоваяЗапись = РегистрыСведений.КСП_СведенияОФайлахЗагрузкиЗаказовКлиента.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ТекущаяДата();
		НоваяЗапись.Файл = ПолноеИмя;
		НоваяЗапись.Заказ = Заказ.Ссылка;
		НоваяЗапись.Режим = Перечисления.КСП_РежимыЗагрузкиФайловЗаказа.Вручную;
		НоваяЗапись.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.КаталогЗагрузки = Константы.КСП_КаталогЗагрузкиЗаказовКлиента.Получить();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлНаСервере(ДвоичДанные, Расширение, ИмяФайла)
	ЗагрузкаЗаказа(ДвоичДанные,Расширение, ИмяФайла);	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	ДиалогФыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогФыбораФайла.Фильтр = "Книга Excel(*.xls; *.xlsx)|*.xls; *.xlsx";
	ДиалогФыбораФайла.Заголовок = "Выберите файл";
	ДиалогФыбораФайла.ПредварительныйПросмотр = Ложь;
	ДиалогФыбораФайла.ИндексФильтра = 0;
	Если ДиалогФыбораФайла.Выбрать() Тогда		
        ИмяФайла = ДиалогФыбораФайла.ПолноеИмяФайла;
	КонецЕсли;	
	
	нФайл = Новый Файл(ИмяФайла);
	
	//Если НЕ нФайл.Существует() Тогда
	//	Возврат;
	//КонецЕсли;
	
	ДвоичДанные = Новый ДвоичныеДанные(ИмяФайла);
	ЗагрузитьФайлНаСервере(ДвоичДанные, нФайл.Расширение, ИмяФайла);

	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

