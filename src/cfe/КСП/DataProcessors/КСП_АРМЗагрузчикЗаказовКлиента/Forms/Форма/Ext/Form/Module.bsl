&НаСервере
Функция ВыгрузитьБланкЗаказаНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	Макет = Обработки.КСП_АРМЗагрузчикЗаказовКлиента.ПолучитьМакет("КСП_БланкЗаказа");
	Область = Макет.ПолучитьОбласть("Бланк");
	ТабДок.Вывести(Область);
	
	возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура ВыгрузитьБланкЗаказа(Команда)

	табПечати = ВыгрузитьБланкЗаказаНаСервере();
	табПечати.Показать();
	
КонецПроцедуры

