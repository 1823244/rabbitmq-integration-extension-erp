
#Область ПрограммныйИнтерфейс

Процедура СформироватьНовыеСтрокиВЗаказеКлиента(ЗаказКлиента, ТаблицаРаспределения, СтолбецЗаказ, СтолбецДоступно, СтолбецЗаказано) Экспорт
	
	//////СтолбецЗаказ, СтолбецДоступно, СтолбецЗаказано
	
	ТаблицаТовары = ЗаказКлиента.Товары.Выгрузить();
	ЗаказКлиентаОбъект = ЗаказКлиента.ПолучитьОбъект();
	ЗаказКлиентаОбъект.Товары.Очистить();
	
	Для каждого СтрокаТЧ из ТаблицаРаспределения Цикл 
		
		Если Не СтрокаТЧ[СтолбецДоступно] = 0 Тогда
			СтрокаТовары = НайтиСтрокиВЗаказеКлиента(ТаблицаТовары, СтрокаТЧ.Номенклатура, СтрокаТЧ.ХарактеристикаНоменклатура);
			
			Если Не СтрокаТовары = Неопределено Тогда
				
				Если СтрокаТЧ[СтолбецДоступно] < СтрокаТЧ[СтолбецЗаказано] Тогда
					
					НоваяСтрокаТЧ = ЗаказКлиентаОбъект.Товары.Добавить();	
					ЗаполнитьСтрокуТЧПоПараметрам(НоваяСтрокаТЧ, СтрокаТЧ[СтолбецДоступно], 
								Перечисления.ВариантыОбеспечения.СоСклада, СтрокаТовары);
					
					НоваяСтрокаТЧ = ЗаказКлиентаОбъект.Товары.Добавить();
					ЗаполнитьСтрокуТЧПоПараметрам(НоваяСтрокаТЧ, СтрокаТЧ[СтолбецЗаказано] - СтрокаТЧ[СтолбецДоступно], 
								Перечисления.ВариантыОбеспечения.КОбеспечению, СтрокаТовары);
								
				Иначе 
								
					НоваяСтрокаТЧ = ЗаказКлиентаОбъект.Товары.Добавить();	
					ЗаполнитьСтрокуТЧПоПараметрам(НоваяСтрокаТЧ, СтрокаТЧ[СтолбецДоступно], 
								Перечисления.ВариантыОбеспечения.СоСклада, СтрокаТовары);			
					
				КонецЕсли;
				
			КонецЕсли		
			
		КонецЕсли;
			
	КонецЦикла
	
КонецПроцедуры


Процедура ЗаполнитьСтрокуТЧПоПараметрам(СтрокаТЧ, Сумма, ВариантОбеспечения, СтрокаТовары)

	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТовары, ,"Номер");	
	СтрокаТЧ.Количество = Сумма;
	СтрокаТЧ.КоличествоУпаковок = Сумма;
	СтрокаТЧ.ВариантОбеспечения = ВариантОбеспечения;
	СтрокаТЧ.Обособленно = Истина;

КонецПроцедуры


Функция НайтиСтрокиВЗаказеКлиента(ТаблицаТовары, Номенклатура, Характеристика)
	
	Для каждого СтрокаТЧ из ТаблицаТовары Цикл 
		
		Если СтрокаТЧ.Номенклатура = Номенклатура И СтрокаТЧ.ХарактеристикаНоменклатуры = Характеристика Тогда
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецФункции

