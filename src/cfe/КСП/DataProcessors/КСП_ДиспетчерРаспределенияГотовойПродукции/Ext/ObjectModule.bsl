Функция ПолучитьНастройкуРаспределенияECOM()  Экспорт

	СтруктураОтбора = Новый Структура;

	СтруктураОтбора.Вставить("Параметр", ПланыВидовХарактеристик.КСП_ПроизвольныеПараметры.РаспределятьECOMВРамкахРозницы);
		
	СтруктураНастроек = РегистрыСведений.КСП_ЗначенияПроизвольныхПараметров.Получить(СтруктураОтбора);
	
	Если  СтруктураНастроек.Значение = Неопределено Тогда 
		Возврат Ложь;
	Иначе 
		Возврат СтруктураНастроек.Значение;
	КонецЕсли;

КонецФункции


Процедура ИнициализироватьДокументПеремещение(ДанныеЗаполнения = Неопределено, ЗаполнятьВариантОбеспечения = Истина, ДокументЗаказНаПеремещение)

	ДокументЗаказНаПеремещение.Автор = Пользователи.ТекущийПользователь();
	ДокументЗаказНаПеремещение.Ответственный = Пользователи.ТекущийПользователь();
	ДокументЗаказНаПеремещение.Организация = ЭтотОбъект.Организация;
	ДокументЗаказНаПеремещение.Подразделение = ЭтотОбъект.ИсточникРаспределения; 
	ДокументЗаказНаПеремещение.Дата = ТекущаяДата();
	
	Если Не Документы.ЗаказНаПеремещение.ИспользоватьСтатусы() Тогда
		ДокументЗаказНаПеремещение.Статус = Перечисления.СтатусыВнутреннихЗаказов.Закрыт;
		
	КонецЕсли;

	Если ЗаполнятьВариантОбеспечения Тогда
		ОбеспечениеВДокументахСервер.ЗаполнитьВариантОбеспеченияПоУмолчанию(ДокументЗаказНаПеремещение.Товары);
	КонецЕсли;
	
	ДокументЗаказНаПеремещение.ОбосабливатьПоНазначениюЗаказа = Константы.ВариантОбособленияТоваровВПеремещении.Получить()
		<> Перечисления.ВариантыОбособленияТоваровВПеремещении.НазначениеПолучателя;
	
	ДокументЗаказНаПеремещение.ВариантПриемкиТоваров = ЗакупкиСервер.ПолучитьВариантПриемкиТоваров();
	ДокументЗаказНаПеремещение.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию(ДокументЗаказНаПеремещение.Приоритет);
	
	ЗначениеСклада = ЭтотОбъект.СкладОстатков;
	//ЗаполнениеОбъектовПоСтатистике.ЗаполнитьРеквизитыОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	// При создании из ОбщаяФома.СозданиеНаОснованииУточнениеЗаказываемогоКоличества может осознанно быть пустым,
	// если в документ переносят данные по нескольким складам. Заполнение по статистике может заполнить это пустое значение,
	// нужно его очистить
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Основание") Тогда
		ДокументЗаказНаПеремещение.СкладПолучатель = ЗначениеСклада;
	КонецЕсли;
	
	//Документы.ЗаказНаПеремещение.ПроверитьИОчиститьОрганизацию(ЭтотОбъект, ОрганизацияПолучатель);
	Документы.ЗаказНаПеремещение.ПроверитьИОчиститьОрганизацию(ДокументЗаказНаПеремещение, ЭтотОбъект.Организация);
	ДокументЗаказНаПеремещение.Комментарий = "Создан автоматически обработкой 'Диспетчер распределения готовой продукции'";
	ДокументЗаказНаПеремещение.КСП_СозданАвтоматически = Истина;
	
	ПараметрыЗаполнения = УчетНДСУПКлиентСервер.ПараметрыЗаполненияВидаДеятельностиНДС();
	ПараметрыЗаполнения.Организация = ЭтотОбъект.Организация;
	ПараметрыЗаполнения.Дата = ТекущаяДатаСеанса();
	ПараметрыЗаполнения.Склад = ДокументЗаказНаПеремещение.СкладПолучатель;
	ПараметрыЗаполнения.ДвижениеТоваровНаСкладах = Истина;
	УчетНДСУП.ЗаполнитьВидДеятельностиНДС(ДокументЗаказНаПеремещение.ПеремещениеПодДеятельность, ПараметрыЗаполнения);
	
КонецПроцедуры


Функция ПолучитьНастройкиРаспределения(Подразделение)
		
	РС = РегистрыСведений.КСП_НастройкиРаспределенияДоступногоОстатка.СоздатьНаборЗаписей();
	РС.Отбор.Подразделение.Установить(Подразделение);
	РС.Отбор.Сезон.Установить(Коллекция);
	РС.Прочитать();
	
	Если РС.Количество()>0 Тогда
		Возврат РС[0].ПроцентРаспределения;
	Иначе
		Возврат 0;
	КонецЕсли;
	
