		ДокКаналОбъект.Автор = ПараметрыСеанса.ТекущийПользователь; 
		ДокКаналОбъект.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний"); 
		ДокКаналОбъект.Комментарий = "Создан автоматически обработкой 'Диспетчер распределения готовой продукции'";
		ДокКаналОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
		Для Каждого Элемент Из МассивСтрок Цикл 
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", Элемент.Номенклатура);
			ПараметрыОтбора.Вставить("Характеристика", Элемент.Характеристика);
			Результат = ДокКаналОбъект["Товары"].НайтиСтроки(ПараметрыОтбора);
			Если Результат.Количество() > 0 Тогда
				СтрокаИзм = Результат[0];
				ЗаполнитьЗначенияСвойств(СтрокаИзм, Результат);
				СтрокаИзм.Количество = ?(Элемент.КолРаспределено < 0, СтрокаИзм.Количество + Элемент.КолРаспределено, Элемент.КолРаспределено);  
				СтрокаИзм.КоличествоУпаковок = ?(Элемент.КолРаспределено < 0, СтрокаИзм.КоличествоУпаковок + Элемент.КолРаспределено, Элемент.КолРаспределено);
				СтрокаИзм.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
				СтрокаИзм.Склад = Элемент.Склад;
				//СтрокаИзм.СтатьяРасходов = ПредопределенноеЗначение(
				//"ПланВидовХарактеристик.СтатьиРасходов.ОтклонениеВСтоимостиТоваров");
			Иначе
				НоваяСтрока = ДокКаналОбъект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент); 
				НоваяСтрока.Количество = Элемент.КолРаспределено; 
				НоваяСтрока.КоличествоУпаковок = Элемент.КолРаспределено;
				НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада; 
				НоваяСтрока.Склад = НоваяСтрока.Склад;
				//НоваяСтрока.СтатьяРасходов = ПредопределенноеЗначение(
				//"ПланВидовХарактеристик.СтатьиРасходов.ОтклонениеВСтоимостиТоваров");
			КонецЕсли;	
		КонецЦикла;                                         
		
		ДокКаналОбъект.Записать(РежимЗаписиДокумента.Запись);	
		
	КонецЦикла;
	
	//ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции	


Функция СоздатьОбщийЗаказКлиентаПоПодразделению(Подравделение, СтрокаПараметры)
	
	ТаблицаЗаказы = НайтиЗаказыКлиентов(Подравделение, СтрокаПараметры); 
		
	Если Не ТаблицаЗаказы.Количество()= 0 Тогда 
		Возврат Ложь; 
	КонецЕсли;

	ДокументЗаказ = Документы.ЗаказКлиента.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ДокументЗаказ, ТаблицаЗаказы[0].Ссылка, , "Номер");

	ДокументЗаказ.Дата = ТекущаяДата();
	ДокументЗаказ.КСП_Коллекция = Коллекция;
	ДокументЗаказ.КСП_Канал =  Подравделение;
	ДокументЗаказ.Организация = Организация;
	ДокументЗаказ.Подразделение = Подравделение;
	ДокументЗаказ.Склад = СкладОстатков;
	ДокументЗаказ.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	ДокументЗаказ.Автор = ПараметрыСеанса.ТекущийПользователь; 
	//ДокументЗаказ.Партнер = КлиентОпт;  
	ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ДокументЗаказ.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний"); 
	ДокументЗаказ.Комментарий = "Создан автоматически обработкой 'Диспетчер распределения готовой продукции'";
	
	Для каждого СтрокаЗаказ из ТаблицаЗаказы Цикл  
		
		Для каждого СтрокаТовары из СтрокаЗаказ.Ссылка.Товары Цикл
			
			НоваяСтрокаТЧ = ДокументЗаказ.Товары.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ,СтрокаТовары, , "КодСтроки, КлючСвязи"); 
			
		КонецЦикла;
			
	КонецЦикла;
	
    ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецФункции


Функция НайтиЗаказыКлиентов(Подразделение, СтрокаПараметров)  Экспорт

	Запрос = Новый Запрос; 
	
	Запрос.Текст = "ВЫБРАТЬ
	             |	ЗаказКлиента.Ссылка КАК Ссылка
	             |ИЗ
	             |	Документ.ЗаказКлиента КАК ЗаказКлиента
	             |ГДЕ
	             |	ЗаказКлиента.Проведен = &Проведен
	             |	И ЗаказКлиента.Склад = &Склад
	             |	И ЗаказКлиента.Организация = &Организация
	             |	И ЗаказКлиента.КСП_Коллекция = &Коллекция";
				
	Запрос.Текст = Запрос.Текст + СтрокаПараметров;
	
	Запрос.Параметры.Вставить("Проведен", Истина); 
	Запрос.Параметры.Вставить("Организация", ЭтотОбъект.Организация);
	Запрос.Параметры.Вставить("Коллекция", ЭтотОбъект.Коллекция);
	Запрос.Параметры.Вставить("Канал", Подразделение);
	Запрос.Параметры.Вставить("Склад", ЭтотОбъект.СкладОстатков);  
	//Запрос.Параметры.Вставить("Статус", Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


