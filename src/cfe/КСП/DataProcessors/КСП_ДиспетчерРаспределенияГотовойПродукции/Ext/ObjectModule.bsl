		МассивСтрок = ЭтотОбъект.РаспределениеКаналы.Строки.НайтиСтроки(ПараметрыПоиска, Истина);
		
		ЗапросДок = Новый Запрос;
		ЗапросДок.Текст = "ВЫБРАТЬ
		                  |	ЗаказНаВнутреннееПотребление.Ссылка КАК Ссылка
