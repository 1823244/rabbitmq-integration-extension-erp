		Возврат;
	КонецЕсли;
	
	ОбработкаОбъект = ЭтотОбъект();
	
	//ОбработкаОбъект.ТекущееРаспределениеНовое(); 
	
	ОбработкаОбъект.ВыполнитьРаспределениеПоКаналамПродаж();	
