&НаКлиенте
Процедура ПанельОсновнаяПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ЭтаФорма.ТекущаяСтраница = ТекущаяСтраница.Имя; 
	
	Элементы.ПоНаправлениямПродаж.Видимость = Ложь;
	Элементы.ПоКаналам.Видимость = Ложь;
	Элементы.ПоКлиентамПодразделений.Видимость = Ложь;
	Элементы.ПоМагазинам.Видимость = Ложь; 
	Элементы.ГруппаПерераспределениеОптРозница.Видимость = Ложь;
	
	Если ТекущаяСтраница.Имя = "СтраницаРаспределениеПоПланамПродаж" Тогда 
		
		Объект.ВидРаспределенияГотовойПродукции = ПредопределенноеЗначение("Перечисление.КСП_ВидРаспределенияГотовойПродукции.РаспределениеГотовойПродукцииПоНаправлениямПродаж");	
		Элементы.ПоНаправлениямПродаж.Видимость = Истина;   
		
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаРаспределениеПоКаналам" Тогда 
		
		Объект.ВидРаспределенияГотовойПродукции = ПредопределенноеЗначение("Перечисление.КСП_ВидРаспределенияГотовойПродукции.РаспределениеГотовойПродукцииНаУровнеРегиональныхПодразделений");
		Элементы.ПоКаналам.Видимость = Истина;  
		
    ИначеЕсли ТекущаяСтраница.Имя = "СтраницаРаспределениеПоОптовымКлиентамПодразделений" Тогда 
		
		Объект.ВидРаспределенияГотовойПродукции = ПредопределенноеЗначение("Перечисление.КСП_ВидРаспределенияГотовойПродукции.РаспределениеГотовойПродукцииНаУровнеОптовыхКлиентовПодразделений");	
		Элементы.ПоКлиентамПодразделений.Видимость = Истина;
		
	ИначеЕсли  ТекущаяСтраница.Имя = "СтраницаРаспределениеГотовойПродукцииНаУровнеМагазинов" Тогда
		
		Объект.ВидРаспределенияГотовойПродукции = ПредопределенноеЗначение("Перечисление.КСП_ВидРаспределенияГотовойПродукции.РаспределениеГотовойПродукцииНаУровнеМагазинов");		
		Элементы.ПоМагазинам.Видимость = Истина;
		
	ИначеЕсли  ТекущаяСтраница.Имя = "СтраницаДокументыРеализации" Тогда
		
	    ЗаполнитьЗаказыКлиентов();     
		
	ИначеЕсли  ТекущаяСтраница.Имя = "ПерераспределениеОптРозница" Тогда	
		
		Элементы.ГруппаПерераспределениеОптРозница.Видимость = Истина;
		
	КонецЕсли;
	
	Объект.РаспределениеКаналы.ПолучитьЭлементы().Очистить();
	Объект.Распределение.ПолучитьЭлементы().Очистить(); 
	ОчиститьТаблицы(); 
	
	Элементы.РаспределениеКаналы.Обновить();
	ОбновитьОтображениеДанных(Элементы.ПанельОсновная);

КонецПроцедуры 


&НаСервере
Процедура ЗаполнитьЗаказыКлиентов()
	
	ОбработкаОбъект = ЭтотОбъект();
	ТаблицаЗаказы = ОбработкаОбъект.НайтиЗаказыКлиентов(Объект.ИсточникРаспределения, "	И ЗаказКлиента.Подразделение = &Канал");
	 
	Для каждого СтрокаТЧ из ТаблицаЗаказы Цикл  
		
		НоваяСтрокаТЧ = ЭтотОбъект.ТаблицаЗаказыКлиентовДляРеализации.Добавить();
		
		ДокументРеализация = ПроверитьСуществующиеДокументыРеализация(СтрокаТЧ.Ссылка);
		
		Если Не ДокументРеализация = Неопределено Тогда
			НоваяСтрокаТЧ.ДокументРеализация = ДокументРеализация[0].Ссылка;
		КонецЕсли;
		
		НоваяСтрокаТЧ.ЗаказКлиента = СтрокаТЧ.Ссылка; 
		
	КонецЦикла;
	
КонецПроцедуры

//Распределение по каналам продаж 

&НаСервере
Процедура ОбъектРаспределениеКаналыКолРаспределеноПриИзмененииНаСервере(НомерСтроки)
	
	ОбъектФормы = РеквизитФормыВЗначение("Объект");              
	ТекущаяСтрока = ОбъектФормы.РаспределениеКаналы.Строки.Найти(НомерСтроки, "НомерЗаписи", Истина);
	ТекущееКоличество = ТекущаяСтрока.КолРаспределено;

	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("Коллекция", ТекущаяСтрока.Коллекция);
	ПараметрыОтбора.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ПараметрыОтбора.Вставить("Характеристика", ТекущаяСтрока.Характеристика);
	НайденныеСтроки = ОбъектФормы.РаспределениеКаналы.Строки.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого Элемент Из НайденныеСтроки Цикл 
		Если Элемент.КолКРаспределению <= ТекущееКоличество Тогда
			
			Если Элемент.НомерЗаписи = НомерСтроки Тогда 
				Элемент.КолРаспределено = ТекущееКоличество;
			КонецЕсли;	
			
			Элемент.КолКРаспределению = 0;
		Иначе
			Элемент.КолКРаспределению = Элемент.КолКРаспределению - ТекущееКоличество;			
		КонецЕсли;
		Элемент.РаспределеноПроц = (Элемент.КолРаспределено / Элемент.КолЗаказано) * 100;
		
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ОбъектФормы, "Объект");

КонецПроцедуры

