	//Иначе
	//	ОбработкаОбъект.ПрименитьНастройкиКомпоновщика(Истина); 
	//КонецЕсли;  
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры  


