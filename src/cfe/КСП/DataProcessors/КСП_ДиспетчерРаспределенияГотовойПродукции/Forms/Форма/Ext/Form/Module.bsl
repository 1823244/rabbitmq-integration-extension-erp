Функция ПроверитьСуществующиеДокументыРеализация(ЗаказКлиента) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	РеализацияТоваровУслуг.ЗаказКлиента = &Основание";
	
	Запрос.Параметры.Вставить("Основание",ЗаказКлиента); 
	
	ТаблицаДокументыРеализации = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДокументыРеализации.Количество() >0 Тогда
		 Возврат ТаблицаДокументыРеализации;
	Иначе
		 Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция СоздатьДокументРеализация(ЗаказКлиента)  
	
	ДокументРеализацияТоваров = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	ДокументРеализацияТоваров.Заполнить(ЗаказКлиента);

	ДокументРеализацияТоваров.Записать(РежимЗаписиДокумента.Запись);
	
КонецФункции

&НаСервере
Процедура СоздатьЗаказКлиентаДляПерераспределенияНаСервере()
	
	
	НовыйЗаказКлиента = Документы.ЗаказКлиента.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйЗаказКлиента, Объект.ЗаказКлиента, ,"Номер");
	НовыйЗаказКлиента.Подразделение = Объект.ПриемникРаспределения;
	НовыйЗаказКлиента.КСП_Канал = Объект.ПриемникРаспределения;
	
	//Заполняем товары в новом документе
	
	ЗаказКлиентаОбъект = Объект.ЗаказКлиента.ПолучитьОбъект(); 
	ЗаказКлиентаОбъект.Товары.Очистить();
	
	Для Каждого СтрокаТЧ из ЭтотОбъект.ТаблицаНоменклатураДляПерераспределения Цикл
		
		СтрокаДокумента = Объект.ЗаказКлиента.Товары.Найти(СтрокаТЧ.НомерСтроки,"НомерСтроки");
		
		Если СтрокаТЧ.Распределять Тогда
			
			НоваяСтрокаТЧ = НовыйЗаказКлиента.Товары.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаДокумента); 
			НоваяСтрокаТЧ.Количество = СтрокаТЧ.КоличествоПерераспределить;
			НоваяСтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.КоличествоПерераспределить;
			
		КонецЕсли; 
		
		
		Если Не СтрокаТЧ.Количество = СтрокаТЧ.КоличествоПерераспределить Тогда
				
			НоваяСтрокаТЧ = ЗаказКлиентаОбъект.Товары.Добавить(); 	
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаДокумента); 
			НоваяСтрокаТЧ.Количество = СтрокаТЧ.Количество - СтрокаТЧ.КоличествоПерераспределить;
			НоваяСтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество - СтрокаТЧ.КоличествоПерераспределить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НовыйЗаказКлиента.Записать(РежимЗаписиДокумента.Запись);
	ЗаказКлиентаОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	ЭтотОбъект.ТаблицаНоменклатураДляПерераспределения.Очистить();
	
	//Перезаписываем старый документ
	
КонецПроцедуры

