		ЗаписатьРаспределениеПоОптовымКлиентам();
			
	ИначеЕсли Объект.ВидРаспределенияГотовойПродукции = ПредопределенноеЗначение("Перечисление.КСП_ВидРаспределенияГотовойПродукции.РаспределениеГотовойПродукцииНаУровнеМагазинов") Тогда	
				
		ЗаписатьРаспределениеПоМагазинам();		
	КонецЕсли;

		
КонецПроцедуры

