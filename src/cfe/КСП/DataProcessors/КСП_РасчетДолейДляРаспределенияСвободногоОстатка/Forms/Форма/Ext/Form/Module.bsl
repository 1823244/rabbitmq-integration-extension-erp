&НаСервере
Функция ПолучитьТаблицуПланПродаж()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланыПродаж.Номенклатура КАК Номенклатура,
				   |	ПланыПродаж.Характеристика КАК ХарактеристикаНоменклатуры,
				   |	ПланыПродаж.Количество КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ПланыПродаж КАК ПланыПродаж
	               |ГДЕ
	               |	ПланыПродаж.Период МЕЖДУ &ДатаНачала И &ДатаОкончания   
				   |	И ПланыПродаж.Подразделение = &Подразделение
				   |	И ПланыПродаж.Статус = &Статус      
				   |	И ПланыПродаж.Сценарий = &Сценарий"; 
	
	//|	И ПланыПродаж.Склад = &Склад
	
	Запрос.Параметры.Вставить("ДатаНачала", Объект.ДатаНачала);
	Запрос.Параметры.Вставить("ДатаОкончания", Объект.ДатаОкончания);
	Запрос.Параметры.Вставить("Сценарий", Объект.Сценарий);
	Запрос.Параметры.Вставить("Подразделение", Объект.Подразделение); 
	//Запрос.Параметры.Вставить("Склад", Объект.Склад);
	Запрос.Параметры.Вставить("Статус", Объект.Статус);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции 

&НаСервере
Функция ПолучитьПредыдущееРаспределение()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КСП_НастройкиРаспределенияДоступногоОстатка.Номенклатура КАК Номенклатура,
	               |	КСП_НастройкиРаспределенияДоступногоОстатка.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	КСП_НастройкиРаспределенияДоступногоОстатка.ПроцентРаспределения КАК Количество
	               |ИЗ
	               |	РегистрСведений.КСП_НастройкиРаспределенияДоступногоОстатка КАК КСП_НастройкиРаспределенияДоступногоОстатка
	               |ГДЕ
	               |	КСП_НастройкиРаспределенияДоступногоОстатка.Подразделение = &Подразделение
				   |	И КСП_НастройкиРаспределенияДоступногоОстатка.Сценарий = &Сценарий
				   |	И КСП_НастройкиРаспределенияДоступногоОстатка.Коллекция = &Коллекция
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Организация = &Организация
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Склад = &Склад"; 
	
	
	Запрос.Параметры.Вставить("ДатаНачала", Объект.ДатаНачала);
	Запрос.Параметры.Вставить("ДатаОкончания", Объект.ДатаОкончания);
	Запрос.Параметры.Вставить("Сценарий", Объект.Сценарий);
	Запрос.Параметры.Вставить("Подразделение", Объект.Подразделение);
	Запрос.Параметры.Вставить("Коллекция", Объект.Коллекция);
	Запрос.Параметры.Вставить("Организация", Объект.Организация);
	Запрос.Параметры.Вставить("Склад", Объект.Склад);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции 

 &НаСервере
Процедура РассчитатьДолиДляРаспределенияНаСервере()
	 
	ВсегоПоПлану = Объект.ПланПродаж.Итог("Количество");
	
	Объект.ДолиРаспределенияПоНоменкалтуре.Очистить();
	
	Для Каждого СтрокаТЧ из Объект.ПланПродаж Цикл  
		
		НоваяСтрокаРаспределения = Объект.ДолиРаспределенияПоНоменкалтуре.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, СтрокаТЧ, "Номенклатура, ХарактеристикаНоменклатуры"); 
		НоваяСтрокаРаспределения.Количество = СтрокаТЧ.Количество/ВсегоПоПлану*100; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДолиДляРаспределения(Команда)
	
	Если Объект.ДолиРаспределенияПоНоменкалтуре.Количество()>0 Тогда  
		
		Режим = РежимДиалогаВопрос.ДаНет;
    	Ответ = Вопрос("По данному набору параметров уже было выполнено автоматическое распределение долей. Обновить распределение?", Режим, 0);
		
		Если Ответ =КодВозвратаДиалога.Да Тогда
			РассчитатьДолиДляРаспределенияНаСервере();
		КонецЕсли;    
		
	Иначе
		
		РассчитатьДолиДляРаспределенияНаСервере();
		
	КонецЕсли;
	
	
КонецПроцедуры

