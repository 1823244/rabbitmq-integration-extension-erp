Функция ПроверитьПроцентРаспределения()

	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(КСП_НастройкиРаспределенияДоступногоОстатка.ПроцентРаспределения) КАК ПроцентРаспределения
	               |ИЗ
	               |	РегистрСведений.КСП_НастройкиРаспределенияДоступногоОстатка КАК КСП_НастройкиРаспределенияДоступногоОстатка
	               |ГДЕ
	               |	КСП_НастройкиРаспределенияДоступногоОстатка.Подразделение = &Подразделение
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Коллекция = &Коллекция
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Сценарий = &Сценарий
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Склад = &Склад
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.Номенклатура <> &Номенклатура
	               |	И КСП_НастройкиРаспределенияДоступногоОстатка.ХарактеристикаНоменклатуры <> &ХарактеристикаНоменклатуры";    
	      
	
	Запрос.Параметры.Вставить("Подразделение", Объект.Подразделение);
	Запрос.Параметры.Вставить("Коллекция", Объект.Коллекция);
	Запрос.Параметры.Вставить("ДатаНачала", Объект.ДатаНачала);
	Запрос.Параметры.Вставить("ДатаОкончания", Объект.ДатаОкончания);
	Запрос.Параметры.Вставить("Номенклатура", Объект.Номенклатура);
	Запрос.Параметры.Вставить("ХарактеристикаНоменклатуры", Объект.ХарактеристикаНоменклатуры);


	ТаблицаПроцентов = Запрос.Выполнить().Выгрузить();
	
	СуммаПроцент = ЭтотОбъект.Запись.ПроцентРаспределения;
	
	Для каждого СтрокаНастроек из  ТаблицаПроцентов Цикл 
		
		СуммаПроцент = СуммаПроцент + СтрокаНастроек.ПроцентРаспределения;
	
	КонецЦикла;
	
	Если СуммаПроцент > 100 Тогда
		Сообщить("Общий процент по группе превышает 100%");
		Возврат Истина;
	КонецЕсли;
КонецФункции


